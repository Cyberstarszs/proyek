<div class="space-y-5 max-w-6xl mx-auto">

  <!-- Pilihan Tahun Langsung -->
  <div class="flex items-center justify-end pb-2 sm:pb-3 border-b border-slate-200">
    <div class="flex items-center justify-between sm:justify-end gap-2 w-full sm:w-auto">
      <form action="/riwayat-tahunan" method="GET" class="flex items-center gap-1.5">
        <label for="tahun" class="text-xs font-semibold text-slate-600">Tahun</label>
        <select 
          id="tahun" 
          name="tahun" 
          onchange="this.form.submit()" 
          class="bg-white border border-slate-300 text-slate-900 text-xs font-bold rounded-lg px-2.5 py-1.5 focus:outline-none"
        >
          <% listTahun.forEach(t => { %>
            <option value="<%= t %>" <%= tahunDipilih === t ? 'selected' : '' %>>Tahun <%= t %></option>
          <% }) %>
        </select>
      </form>
    </div>
  </div>

  <!-- Kartu Total Konsolidasi dengan Motif Bangunan & Infrastruktur -->
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 sm:gap-3">
    <!-- Modal Masuk (Motif Bangunan Arsitektur) -->
    <div class="relative overflow-hidden p-3 sm:p-4 rounded-xl border border-slate-200 bg-white shadow-sm group">
      <svg class="absolute -right-2 -bottom-2 w-24 h-18 text-slate-900/6 pointer-events-none select-none transition-transform duration-500 group-hover:scale-105" viewBox="0 0 200 140" fill="none" stroke="currentColor">
        <path d="M50 135V75L120 25L190 75V135H50Z" stroke-width="2" />
        <path d="M42 78L120 22L198 78" stroke-width="2.5" />
      </svg>
      <span class="relative z-10 text-[10px] sm:text-xs font-semibold text-slate-500 uppercase tracking-wider block truncate">Modal Masuk</span>
      <div class="relative z-10 text-base sm:text-xl font-bold font-mono text-slate-900 mt-0.5 sm:mt-1 truncate">
        Rp<%= totalSemuaCabang.modalMasuk.toLocaleString('id-ID') %>
      </div>
    </div>

    <!-- Tarik Modal (Motif Tower Crane) -->
    <div class="relative overflow-hidden p-3 sm:p-4 rounded-xl border border-slate-200 bg-white shadow-sm group">
      <svg class="absolute -right-2 -bottom-2 w-24 h-18 text-slate-900/6 pointer-events-none select-none transition-transform duration-500 group-hover:scale-105" viewBox="0 0 220 150" fill="none" stroke="currentColor">
        <line x1="82" y1="16" x2="82" y2="142" stroke-width="2" />
        <line x1="94" y1="16" x2="94" y2="142" stroke-width="2" />
        <line x1="38" y1="16" x2="208" y2="16" stroke-width="2.5" />
      </svg>
      <span class="relative z-10 text-[10px] sm:text-xs font-semibold text-slate-500 uppercase tracking-wider block truncate">Tarik Modal</span>
      <div class="relative z-10 text-base sm:text-xl font-bold font-mono text-slate-900 mt-0.5 sm:mt-1 truncate">
        Rp<%= totalSemuaCabang.penarikanModal.toLocaleString('id-ID') %>
      </div>
    </div>

    <!-- Realisasi Belanja (Motif Jembatan Infrastruktur) -->
    <div class="relative overflow-hidden col-span-2 sm:col-span-1 p-3.5 sm:p-4 rounded-xl border border-slate-900 bg-slate-900 text-white shadow-sm group">
      <svg class="absolute -right-2 -bottom-2 w-26 h-18 text-white/10 pointer-events-none select-none transition-transform duration-500 group-hover:scale-105" viewBox="0 0 240 145" fill="none" stroke="currentColor">
        <path d="M5 106H235" stroke-width="3" />
        <path d="M136 12L127 106M136 12L145 106" stroke-width="2.5" />
        <line x1="136" y1="22" x2="55" y2="106" stroke-width="1.2" />
      </svg>
      <span class="relative z-10 text-[10px] sm:text-xs font-semibold text-slate-400 uppercase tracking-wider block">Realisasi Belanja (<%= tahunDipilih %>)</span>
      <div class="relative z-10 text-lg sm:text-xl font-extrabold font-mono text-emerald-400 mt-0.5 sm:mt-1">
        Rp<%= totalSemuaCabang.biayaRealisasi.toLocaleString('id-ID') %>
      </div>
    </div>
  </div>

  <!-- Tabel Riwayat Per Cabang -->
  <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-100 text-left text-xs">
        <thead class="bg-slate-50 text-slate-600 font-semibold uppercase tracking-wider text-[11px]">
          <tr>
            <th class="py-3 px-4">Cabang</th>
            <th class="py-3 px-4 text-right">Modal Masuk</th>
            <th class="py-3 px-4 text-right">Penarikan Modal</th>
            <th class="py-3 px-4 text-right">Biaya Realisasi</th>
            <th class="py-3 px-4 text-center">Proyek</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-slate-700">
          <% rekapCabang.forEach((r, idx) => { %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="py-3 px-4 font-bold text-slate-900">
                <%= r.cabang.nama %> <%= r.cabang.kota ? '(' + r.cabang.kota + ')' : '' %>
              </td>
              <td class="py-3 px-4 text-right font-mono">
                Rp<%= r.modalMasuk.toLocaleString('id-ID') %>
              </td>
              <td class="py-3 px-4 text-right font-mono">
                Rp<%= r.penarikanModal.toLocaleString('id-ID') %>
              </td>
              <td class="py-3 px-4 text-right font-mono font-bold text-slate-900">
                Rp<%= r.biayaRealisasi.toLocaleString('id-ID') %>
              </td>
              <td class="py-3 px-4 text-center">
                <% if (r.proyekList.length > 0) { %>
                  <button 
                    onclick="toggleRincianProyek(<%= idx %>)" 
                    class="px-2 py-0.5 rounded text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-800 transition-colors"
                  >
                    Rincian (<%= r.proyekList.length %>)
                  </button>
                <% } else { %>
                  <span class="text-slate-400 italic">0</span>
                <% } %>
              </td>
            </tr>

            <!-- Rincian Proyek & Detail Pembelian -->
            <% if (r.proyekList.length > 0) { %>
              <tr id="rincian-cabang-<%= idx %>" class="hidden bg-slate-50/70">
                <td colspan="5" class="p-3">
                  <div class="bg-white border border-slate-200 rounded-xl p-3 shadow-xs space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                      <h4 class="text-xs font-bold text-slate-800">Daftar Proyek di <%= r.cabang.nama %> (<%= tahunDipilih %>)</h4>
                      <span class="text-[11px] text-slate-400">Klik "Rincian Belanja" untuk melihat setiap item pembelian</span>
                    </div>

                    <div class="space-y-2">
                      <% r.proyekList.forEach((p, pIdx) => { %>
                        <div class="border border-slate-200 rounded-lg overflow-hidden bg-white">
                          <!-- Baris Ringkasan Proyek -->
                          <div class="p-2.5 bg-slate-50/50 flex flex-wrap items-center justify-between gap-2 text-xs">
                            <div class="flex items-center space-x-2">
                              <a href="/proyek/<%= p.id %>" class="font-bold text-slate-900 hover:text-emerald-700 flex items-center space-x-1">
                                <span><%= p.nama %></span>
                                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                              </a>
                            </div>

                            <div class="flex flex-wrap items-center gap-2 sm:gap-4">
                              <div class="text-[11px]">
                                <span class="text-slate-400">Modal:</span>
                                <span class="font-mono font-medium text-slate-700 ml-0.5">Rp<%= p.modalMasuk.toLocaleString('id-ID') %></span>
                              </div>
                              <div class="text-[11px]">
                                <span class="text-slate-400">Belanja:</span>
                                <span class="font-mono font-bold text-slate-900 ml-0.5">Rp<%= p.biayaRealisasi.toLocaleString('id-ID') %></span>
                              </div>
                              <button 
                                type="button"
                                onclick="toggleBelanjaProyek(<%= idx %>, <%= pIdx %>)" 
                                class="px-2.5 py-1 rounded-md text-[11px] font-bold transition-colors <%= p.transaksiBelanja && p.transaksiBelanja.length > 0 ? 'bg-slate-900 text-white hover:bg-slate-800' : 'bg-slate-200 text-slate-500 cursor-not-allowed' %>"
                                <%= (!p.transaksiBelanja || p.transaksiBelanja.length === 0) ? 'disabled' : '' %>
                              >
                                Detail Belanja (<%= p.transaksiBelanja ? p.transaksiBelanja.length : 0 %>)
                              </button>
                            </div>
                          </div>

                          <!-- Tabel Item Pembelian / Pengeluaran Lengkap Proyek -->
                          <div id="belanja-proyek-<%= idx %>-<%= pIdx %>" class="hidden p-3 border-t border-slate-200 bg-white">
                            <% if (p.transaksiBelanja && p.transaksiBelanja.length > 0) { %>
                              <div class="overflow-x-auto">
                                <table class="min-w-full divide-y divide-slate-100 text-left text-[11px]">
                                  <thead class="bg-slate-50 text-slate-600 font-bold uppercase tracking-wider text-[10px]">
                                    <tr>
                                      <th class="py-2 px-2.5">Tanggal</th>
                                      <th class="py-2 px-2.5">Kategori</th>
                                      <th class="py-2 px-2.5">Nama Pengeluaran / Barang</th>
                                      <th class="py-2 px-2.5">Toko / Rekanan</th>
                                      <th class="py-2 px-2.5 text-right">Nominal</th>
                                    </tr>
                                  </thead>
                                  <tbody class="divide-y divide-slate-100 text-slate-700">
                                    <% p.transaksiBelanja.forEach(tb => { %>
                                      <tr class="hover:bg-slate-50/70">
                                        <td class="py-2 px-2.5 font-mono text-slate-500 whitespace-nowrap"><%= tb.tanggal_transaksi %></td>
                                        <td class="py-2 px-2.5 font-medium whitespace-nowrap">
                                          <span class="px-1.5 py-0.5 bg-slate-100 text-slate-700 rounded text-[10px] font-semibold">
                                            <%= tb.nama_kategori || 'Tanpa Kategori' %>
                                          </span>
                                        </td>
                                        <td class="py-2 px-2.5 font-semibold text-slate-900"><%= tb.uraian %></td>
                                        <td class="py-2 px-2.5 text-slate-500"><%= tb.vendor || '-' %></td>
                                        <td class="py-2 px-2.5 text-right font-mono font-bold text-slate-900 whitespace-nowrap">
                                          Rp<%= Number(tb.nominal).toLocaleString('id-ID') %>
                                        </td>
                                      </tr>
                                    <% }) %>
                                  </tbody>
                                  <tfoot class="bg-slate-50 font-bold border-t border-slate-200">
                                    <tr>
                                      <td colspan="4" class="py-2 px-2.5 text-slate-900">Total Pengeluaran Proyek (<%= p.nama %>)</td>
                                      <td class="py-2 px-2.5 text-right font-mono text-slate-900">Rp<%= p.biayaRealisasi.toLocaleString('id-ID') %></td>
                                    </tr>
                                  </tfoot>
                                </table>
                              </div>
                            <% } else { %>
                              <p class="text-xs text-slate-400 py-2 text-center">Tidak ada catatan belanja pada tahun <%= tahunDipilih %>.</p>
                            <% } %>
                          </div>

                        </div>
                      <% }) %>
                    </div>
                  </div>
                </td>
              </tr>
            <% } %>

          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<script>
  function toggleRincianProyek(idx) {
    const el = document.getElementById('rincian-cabang-' + idx);
    if (el) {
      el.classList.toggle('hidden');
    }
  }

  function toggleBelanjaProyek(cabangIdx, proyekIdx) {
    const el = document.getElementById(`belanja-proyek-${cabangIdx}-${proyekIdx}`);
    if (el) {
      el.classList.toggle('hidden');
    }
  }
</script>

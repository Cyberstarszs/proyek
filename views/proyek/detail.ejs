<div class="space-y-5 max-w-7xl mx-auto pb-16 sm:pb-0">
  <%
    // Skala Warna Kartu Finansial & Motif Pembangunan Konsisten dengan Dasbor
    const detailModalVal = Number(saldo.modalBersih || saldo.biayaTerealisasi || 0);
    let detailTier = {
      level: 1,
      nama: 'Mikro',
      motifNama: 'Rumah & Hunian',
      rentang: '<50 Jt',
      saldoCardBg: 'bg-teal-50/80 border-teal-200 text-teal-950',
      subCardBg: 'bg-teal-50/50 border-teal-200 text-teal-950',
      saldoValColor: 'text-teal-950',
      valColor: 'text-teal-950',
      labelColor: 'text-teal-700',
      catatBtnBg: 'bg-teal-700 hover:bg-teal-800 text-white',
      badgeClass: 'bg-teal-50 text-teal-700 border-teal-200',
      svgColor: 'text-teal-700/15'
    };
    if (detailModalVal >= 1500000000) {
      detailTier = {
        level: 5,
        nama: 'Mega',
        motifNama: 'Pencakar Langit',
        rentang: '>1.5 M',
        saldoCardBg: 'bg-slate-900 border-slate-800 text-white',
        subCardBg: 'bg-slate-900/90 border-slate-800 text-white',
        saldoValColor: 'text-emerald-400',
        valColor: 'text-white',
        labelColor: 'text-slate-400',
        catatBtnBg: 'bg-emerald-600 hover:bg-emerald-500 text-white',
        badgeClass: 'bg-slate-900 text-white border-slate-800',
        svgColor: 'text-white/10'
      };
    } else if (detailModalVal >= 500000000) {
      detailTier = {
        level: 4,
        nama: 'Besar',
        motifNama: 'Jembatan & Viaduct',
        rentang: '500Jt-1.5M',
        saldoCardBg: 'bg-pink-50/80 border-pink-200 text-pink-950',
        subCardBg: 'bg-pink-50/50 border-pink-200 text-pink-950',
        saldoValColor: 'text-pink-950',
        valColor: 'text-pink-950',
        labelColor: 'text-pink-700',
        catatBtnBg: 'bg-pink-700 hover:bg-pink-800 text-white',
        badgeClass: 'bg-pink-50 text-pink-700 border-pink-200',
        svgColor: 'text-pink-700/15'
      };
    } else if (detailModalVal >= 150000000) {
      detailTier = {
        level: 3,
        nama: 'Menengah',
        motifNama: 'Crane & Rangka Baja',
        rentang: '150-500Jt',
        saldoCardBg: 'bg-amber-50/80 border-amber-200 text-amber-950',
        subCardBg: 'bg-amber-50/50 border-amber-200 text-amber-950',
        saldoValColor: 'text-amber-950',
        valColor: 'text-amber-950',
        labelColor: 'text-amber-700',
        catatBtnBg: 'bg-amber-600 hover:bg-amber-700 text-white',
        badgeClass: 'bg-amber-50 text-amber-800 border-amber-200',
        svgColor: 'text-amber-700/15'
      };
    } else if (detailModalVal >= 50000000) {
      detailTier = {
        level: 2,
        nama: 'Kecil',
        motifNama: 'Ruko & Komersial',
        rentang: '50-150Jt',
        saldoCardBg: 'bg-blue-50/80 border-blue-200 text-blue-950',
        subCardBg: 'bg-blue-50/50 border-blue-200 text-blue-950',
        saldoValColor: 'text-blue-950',
        valColor: 'text-blue-950',
        labelColor: 'text-blue-700',
        catatBtnBg: 'bg-blue-600 hover:bg-blue-700 text-white',
        badgeClass: 'bg-blue-50 text-blue-700 border-blue-200',
        svgColor: 'text-blue-700/15'
      };
    }
  %>

  <!-- Bilah Tombol Navigasi Kembali -->
  <div class="flex items-center justify-between gap-2 pb-0.5">
    <a 
      href="/" 
      onclick="if (window.history.length > 1 && document.referrer.includes(window.location.host)) { event.preventDefault(); window.history.back(); }" 
      class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 text-xs font-semibold shadow-2xs transition-all shrink-0"
      title="Kembali ke halaman sebelumnya"
    >
      <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
      </svg>
      <span>Kembali</span>
    </a>
  </div>

  <!-- 3 Kartu Metrik dengan Konsistensi Warna Kartu Finansial Proyek -->
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3">
    
    <!-- Saldo Kas Proyek -->
    <div class="relative overflow-hidden col-span-2 sm:col-span-1 p-3.5 sm:p-4 rounded-xl border transition-all <%= saldo.isKasMinus ? 'bg-rose-50 border-rose-300' : detailTier.saldoCardBg %> shadow-xs group">
      <!-- Watermark Motif Pembangunan Sesuai Level Proyek -->
      <% if (!saldo.isKasMinus) { %>
        <% if (detailTier.level === 1) { %>
          <!-- Motif Rumah -->
          <svg class="absolute -right-3 -bottom-3 w-32 h-24 <%= detailTier.svgColor %> pointer-events-none select-none transition-transform duration-500 group-hover:scale-105" viewBox="0 0 200 140" fill="none" stroke="currentColor">
            <path d="M50 135V75L120 25L190 75V135H50Z" stroke-width="2" fill="currentColor" fill-opacity="0.05" />
            <path d="M42 78L120 22L198 78" stroke-width="2.5" />
            <rect x="70" y="85" width="28" height="32" rx="2" stroke-width="1.5" />
            <rect x="142" y="85" width="28" height="32" rx="2" stroke-width="1.5" />
          </svg>
        <% } else if (detailTier.level === 2) { %>
          <!-- Motif Ruko -->
          <svg class="absolute -right-3 -bottom-3 w-32 h-24 <%= detailTier.svgColor %> pointer-events-none select-none transition-transform duration-500 group-hover:scale-105" viewBox="0 0 200 145" fill="none" stroke="currentColor">
            <rect x="65" y="22" width="75" height="116" rx="1.5" stroke-width="2" fill="currentColor" fill-opacity="0.05" />
            <path d="M60 22H145" stroke-width="2.5" />
            <line x1="65" y1="62" x2="140" y2="62" stroke-width="1.8" />
            <line x1="65" y1="98" x2="140" y2="98" stroke-width="1.8" />
          </svg>
        <% } else if (detailTier.level === 3) { %>
          <!-- Motif Crane & Baja -->
          <svg class="absolute -right-3 -bottom-3 w-32 h-24 <%= detailTier.svgColor %> pointer-events-none select-none transition-transform duration-500 group-hover:scale-105" viewBox="0 0 220 150" fill="none" stroke="currentColor">
            <line x1="82" y1="16" x2="82" y2="142" stroke-width="2" />
            <line x1="94" y1="16" x2="94" y2="142" stroke-width="2" />
            <line x1="38" y1="16" x2="208" y2="16" stroke-width="2.5" />
            <path d="M88 4L42 16M88 4L130 16M88 4L170 16" stroke-width="1.2" />
          </svg>
        <% } else if (detailTier.level === 4) { %>
          <!-- Motif Jembatan Gantung -->
          <svg class="absolute -right-3 -bottom-3 w-36 h-26 <%= detailTier.svgColor %> pointer-events-none select-none transition-transform duration-500 group-hover:scale-105" viewBox="0 0 240 145" fill="none" stroke="currentColor">
            <path d="M5 106H235" stroke-width="3" />
            <path d="M136 12L127 106M136 12L145 106" stroke-width="2.5" />
            <line x1="136" y1="22" x2="55" y2="106" stroke-width="1.2" />
            <line x1="136" y1="42" x2="88" y2="106" stroke-width="1.2" />
            <line x1="136" y1="22" x2="218" y2="106" stroke-width="1.2" />
            <line x1="136" y1="42" x2="184" y2="106" stroke-width="1.2" />
          </svg>
        <% } else if (detailTier.level === 5) { %>
          <!-- Motif Pencakar Langit -->
          <svg class="absolute -right-3 -bottom-3 w-32 h-26 <%= detailTier.svgColor %> pointer-events-none select-none transition-transform duration-500 group-hover:scale-105" viewBox="0 0 220 155" fill="none" stroke="currentColor">
            <line x1="112" y1="4" x2="112" y2="25" stroke-width="2" />
            <path d="M102 25H122L127 62L133 105L137 148H87L91 105L97 62L102 25Z" stroke-width="2" fill="currentColor" fill-opacity="0.08" />
            <line x1="97" y1="62" x2="127" y2="62" stroke-width="1.5" />
            <line x1="91" y1="105" x2="133" y2="105" stroke-width="1.5" />
          </svg>
        <% } %>
      <% } %>

      <div class="relative z-10 flex items-center justify-between text-xs font-bold uppercase tracking-wider <%= saldo.isKasMinus ? 'text-rose-700' : (detailTier.level === 5 ? 'text-slate-300' : detailTier.labelColor) %>">
        <span class="truncate max-w-[200px]" title="<%= proyek.nama %>"><%= proyek.nama %></span>
        <% if (saldo.isKasMinus) { %>
          <span class="text-[10px] bg-white text-rose-600 px-1.5 py-0.5 rounded border border-rose-200 font-bold shrink-0">Defisit</span>
        <% } else { %>
          <span class="text-[9px] font-bold px-1.5 py-0.2 rounded border <%= detailTier.badgeClass %> shrink-0"><%= detailTier.nama %></span>
        <% } %>
      </div>
      <span class="relative z-10 text-xl sm:text-2xl font-extrabold font-mono block mt-1 <%= saldo.isKasMinus ? 'text-rose-700' : detailTier.saldoValColor %>">
        Rp<%= saldo.saldoKas.toLocaleString('id-ID') %>
      </span>
      <span class="relative z-10 text-[11px] <%= detailTier.level === 5 && !saldo.isKasMinus ? 'text-slate-400' : 'text-slate-500' %> block mt-0.5 truncate">
        Saldo Kas<% if (proyek.lokasi) { %> • <%= proyek.lokasi %><% } %>
      </span>
    </div>

    <!-- Total Belanja (Konsisten dengan Warna Card Induk) -->
    <div class="p-3.5 sm:p-4 rounded-xl border <%= detailTier.subCardBg %> shadow-xs">
      <span class="text-[11px] sm:text-xs font-semibold <%= detailTier.labelColor %> uppercase tracking-wider block">Total Belanja</span>
      <span class="text-base sm:text-2xl font-extrabold font-mono <%= detailTier.valColor %> block mt-1">
        Rp<%= saldo.biayaTerealisasi.toLocaleString('id-ID') %>
      </span>
      <span class="text-[10px] sm:text-[11px] <%= detailTier.level === 5 ? 'text-slate-400' : 'text-slate-500' %> block mt-0.5">Realisasi belanja</span>
    </div>

    <!-- Modal Bersih (Konsisten dengan Warna Card Induk) -->
    <div class="p-3.5 sm:p-4 rounded-xl border <%= detailTier.subCardBg %> shadow-xs">
      <div class="flex items-center justify-between">
        <span class="text-[11px] sm:text-xs font-semibold <%= detailTier.labelColor %> uppercase tracking-wider block">Modal Bersih</span>
        <span class="text-[9px] font-bold px-1.5 py-0.2 rounded border <%= detailTier.badgeClass %>"><%= detailTier.rentang %></span>
      </div>
      <span class="text-base sm:text-2xl font-extrabold font-mono <%= detailTier.valColor %> block mt-1">
        Rp<%= saldo.modalBersih.toLocaleString('id-ID') %>
      </span>
      <span class="text-[10px] sm:text-[11px] <%= detailTier.level === 5 ? 'text-slate-400' : 'text-slate-500' %> block mt-0.5">Suntikan modal</span>
    </div>

  </div>

  <!-- Aksi Cepat Bar Atas -->
  <% if (proyek.status === 'Aktif') { %>
    <div class="bg-white border border-slate-200 rounded-xl p-3 shadow-sm flex items-center justify-between flex-wrap gap-2">
      <div class="flex items-center space-x-2 w-full sm:w-auto">
        <button onclick="openModal('modal-pengeluaran')" class="flex-1 sm:flex-initial justify-center px-4 py-2 <%= detailTier.catatBtnBg %> text-xs font-semibold rounded-lg shadow-sm transition-all flex items-center space-x-1.5">
          <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
          <span>Catat Belanja</span>
          <span class="hidden sm:inline-block ml-1 text-[10px] text-white/80 font-mono bg-black/20 px-1 py-0.2 rounded">B</span>
        </button>
      </div>

      <div class="flex items-center space-x-2 w-full sm:w-auto justify-end">
        <button 
          type="button" 
          onclick="openModal('modal-akhiri-proyek')" 
          class="px-3 py-2 text-xs font-semibold rounded-lg text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-all flex items-center space-x-1"
          title="Akhiri proyek dan pindahkan ke Histori"
        >
          <svg class="w-3.5 h-3.5 text-rose-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span>Akhiri Proyek</span>
        </button>
      </div>
    </div>
  <% } else if (proyek.status === 'Selesai') { %>
    <div class="p-3.5 bg-slate-900 text-white rounded-xl text-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-sm">
      <div class="flex items-center space-x-2.5">
        <div class="h-8 w-8 rounded-lg bg-slate-800 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
        </div>
        <div>
          <div class="font-bold text-white text-xs sm:text-sm flex items-center space-x-1.5">
            <span>Proyek Selesai</span>
            <% if (proyek.tanggal_selesai) { %>
              <span class="text-slate-400 font-normal">• Selesai pada <%= proyek.tanggal_selesai %></span>
            <% } %>
          </div>
          <p class="text-[11px] text-slate-400 mt-0.5">
            Mulai: <%= proyek.tanggal_mulai %> <% if (proyek.tanggal_selesai) { %>• Durasi: <%= Math.max(1, Math.round((new Date(proyek.tanggal_selesai) - new Date(proyek.tanggal_mulai)) / (1000 * 60 * 60 * 24))) %> Hari<% } %> • Tersimpan di <a href="/histori" class="text-emerald-400 underline font-semibold">Histori</a>
          </p>
        </div>
      </div>
      <form action="/proyek/<%= proyek.id %>/aktifkan-kembali" method="POST" onsubmit="return confirm('Buka kembali proyek ini agar dapat mencatat transaksi lagi?')" class="shrink-0 w-full sm:w-auto">
        <button type="submit" class="w-full sm:w-auto px-3 py-1.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white text-xs font-semibold rounded-lg transition-colors">
          Buka Kembali Proyek
        </button>
      </form>
    </div>
  <% } else { %>
    <div class="p-3 bg-slate-100 border border-slate-200 rounded-xl text-xs text-slate-600 flex items-center justify-between">
      <span>Status proyek <strong><%= proyek.status %></strong> (Terkunci).</span>
      <button onclick="switchTab('pengaturan')" class="font-semibold text-slate-900 underline">Pengaturan</button>
    </div>
  <% } %>

  <!-- Tab Navigasi -->
  <div class="border-b border-slate-200">
    <nav class="flex space-x-6 text-xs font-semibold overflow-x-auto no-scrollbar">
      <button id="btn-tab-bukukas" onclick="switchTab('bukukas')" class="tab-btn pb-2.5 border-b-2 whitespace-nowrap <%= activeTab === 'bukukas' ? 'border-slate-900 text-slate-900' : 'border-transparent text-slate-500 hover:text-slate-800' %>">
        Buku Kas (<%= transaksiList.length %>)
      </button>
      <button id="btn-tab-anggaran" onclick="switchTab('anggaran')" class="tab-btn pb-2.5 border-b-2 whitespace-nowrap <%= activeTab === 'anggaran' ? 'border-slate-900 text-slate-900' : 'border-transparent text-slate-500 hover:text-slate-800' %>">
        Anggaran
      </button>
      <button id="btn-tab-patokan" onclick="switchTab('patokan')" class="tab-btn pb-2.5 border-b-2 whitespace-nowrap <%= activeTab === 'patokan' ? 'border-slate-900 text-slate-900' : 'border-transparent text-slate-500 hover:text-slate-800' %>">
        Estimasi / m²
      </button>
      <button id="btn-tab-audit" onclick="switchTab('audit')" class="tab-btn pb-2.5 border-b-2 whitespace-nowrap <%= activeTab === 'audit' ? 'border-slate-900 text-slate-900' : 'border-transparent text-slate-500 hover:text-slate-800' %>">
        Riwayat (<%= auditLogs.length %>)
      </button>
      <button id="btn-tab-pengaturan" onclick="switchTab('pengaturan')" class="tab-btn pb-2.5 border-b-2 whitespace-nowrap <%= activeTab === 'pengaturan' ? 'border-slate-900 text-slate-900' : 'border-transparent text-slate-500 hover:text-slate-800' %>">
        Pengaturan
      </button>
    </nav>
  </div>

  <!-- TAB 1: BUKU KAS -->
  <div id="tab-bukukas" class="tab-content <%= activeTab === 'bukukas' ? '' : 'hidden' %> space-y-3">
    
    <!-- Filter & Pencarian Cepat -->
    <div class="bg-white p-3 border border-slate-200 rounded-xl flex flex-wrap items-center justify-between gap-2.5 text-xs shadow-sm">
      <form id="form-filter-bukukas" action="/proyek/<%= proyek.id %>" method="GET" class="flex flex-wrap items-center gap-2">
        <input type="hidden" name="tab" value="bukukas">
        <input type="hidden" id="filter-jenis-val" name="jenis" value="<%= filterJenis || '' %>">
        
        <!-- Pilihan Jenis Transaksi 1-Tap (Pill Segmented) -->
        <div class="inline-flex items-center p-0.5 bg-slate-100 rounded-lg">
          <button 
            type="button" 
            onclick="pilihFilterJenis('')" 
            class="px-2.5 py-1 rounded-md text-xs font-semibold transition-all <%= !filterJenis ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500 hover:text-slate-800' %>"
          >
            Semua
          </button>
          <button 
            type="button" 
            onclick="pilihFilterJenis('PENGELUARAN_LANGSUNG')" 
            class="px-2.5 py-1 rounded-md text-xs font-semibold transition-all <%= filterJenis === 'PENGELUARAN_LANGSUNG' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500 hover:text-slate-800' %>"
          >
            Belanja
          </button>
          <button 
            type="button" 
            onclick="pilihFilterJenis('MODAL_MASUK')" 
            class="px-2.5 py-1 rounded-md text-xs font-semibold transition-all <%= filterJenis === 'MODAL_MASUK' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500 hover:text-slate-800' %>"
          >
            Modal
          </button>
        </div>

        <select name="kategori_id" onchange="this.form.submit()" class="border border-slate-300 rounded-lg px-2.5 py-1.5 bg-white text-slate-800 focus:outline-none focus:ring-1 focus:ring-slate-900">
          <option value="">Semua Kategori</option>
          <% kategoriList.forEach(k => { %>
            <option value="<%= k.id %>" <%= filterKategori === k.id ? 'selected' : '' %>><%= k.nama %></option>
          <% }) %>
        </select>

        <label class="flex items-center space-x-1.5 ml-1 cursor-pointer text-slate-500 text-xs select-none">
          <input type="checkbox" name="show_cancelled" value="1" <%= showCancelled ? 'checked' : '' %> onchange="this.form.submit()" class="rounded border-slate-300 text-slate-900 focus:ring-0">
          <span>Dibatalkan</span>
        </label>
      </form>

      <!-- Kotak Pencarian Instan Baris Tabel & Mobile Cards -->
      <div class="flex items-center space-x-2 w-full sm:w-auto">
        <div class="relative w-full sm:w-64">
          <input 
            type="text" 
            id="input-cari-bukukas"
            oninput="filterTabelBukuKas(this)"
            placeholder="Cari..." 
            class="w-full px-2.5 py-1.5 pl-8 pr-7 border border-slate-300 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
          >
          <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          <button 
            type="button" 
            id="search-clear-btn" 
            onclick="clearBukuKasSearch()" 
            class="hidden absolute right-2 top-2 text-slate-400 hover:text-slate-600 text-xs"
            title="Bersihkan"
          >
            &times;
          </button>
        </div>
        <span id="search-counter" class="text-[11px] text-slate-500 font-mono hidden whitespace-nowrap"></span>
      </div>
    </div>

    <!-- Total Pengeluaran Kategori Saat Filter Aktif -->
    <% if (filterKategori && namaFilterKategori) { %>
      <div class="bg-emerald-50/80 border border-emerald-200 rounded-xl p-3 sm:p-3.5 flex items-center justify-between shadow-xs">
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0"></span>
          <span class="text-xs font-semibold text-emerald-950">
            Total Kategori <strong class="text-emerald-900 font-bold"><%= namaFilterKategori %></strong>
          </span>
          <a href="/proyek/<%= proyek.id %>?tab=bukukas" class="text-[11px] text-emerald-700 hover:text-emerald-900 underline font-medium ml-2">
            Reset
          </a>
        </div>
        <div class="text-sm sm:text-base font-extrabold font-mono text-emerald-800">
          Rp<%= totalFilterKategori.toLocaleString('id-ID') %>
        </div>
      </div>
    <% } %>

    <!-- Peringatan Jika Pencarian Tidak Menemukan Hasil -->
    <div id="search-no-match" class="hidden bg-white border border-slate-200 rounded-xl p-8 text-center text-xs text-slate-400">
      Tidak ada data yang cocok.
    </div>

    <!-- Mutasi Kas: Desktop View (Tabel Bersih) -->
    <div class="hidden md:block bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table id="tabel-buku-kas" class="min-w-full divide-y divide-slate-100 text-left text-xs">
          <thead class="bg-slate-50 text-slate-600 font-semibold uppercase tracking-wider text-[11px]">
            <tr>
              <th class="py-3 px-3.5">Tanggal</th>
              <th class="py-3 px-3.5">Jenis</th>
              <th class="py-3 px-3.5">Kategori</th>
              <th class="py-3 px-3.5">Pengeluaran / Rekanan</th>
              <th class="py-3 px-3.5 text-right">Nominal</th>
              <th class="py-3 px-3.5 text-right">Saldo Kas</th>
              <th class="py-3 px-3.5 text-right">Aksi</th>
            </tr>
          </thead>

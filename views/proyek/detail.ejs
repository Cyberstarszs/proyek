        </span>
      </div>
      <div>
        <span class="text-[10px] sm:text-xs text-slate-400 block">Sisa</span>
        <span class="text-xs sm:text-xl font-bold font-mono <%= (totalPaguAnggaran - saldo.biayaTerealisasi) < 0 ? 'text-rose-700' : 'text-slate-900' %> block mt-0.5">
          Rp<%= (totalPaguAnggaran - saldo.biayaTerealisasi).toLocaleString('id-ID') %>
        </span>

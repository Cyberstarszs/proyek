      <h3 class="text-sm font-bold text-slate-900">Status Proyek</h3>
      <form action="/proyek/<%= proyek.id %>/status" method="POST" class="flex flex-wrap items-center gap-2">
        <select name="status" id="select-status-pengaturan" onchange="toggleTanggalSelesaiInput(this.value)" class="px-3 py-1.5 bg-slate-50 border border-slate-300 rounded-lg text-xs font-semibold text-slate-900">
          <option value="Aktif" <%= proyek.status === 'Aktif' ? 'selected' : '' %>>Aktif</option>
          <option value="Selesai" <%= proyek.status === 'Selesai' ? 'selected' : '' %>>Selesai</option>
          <option value="Arsip" <%= proyek.status === 'Arsip' ? 'selected' : '' %>>Arsip</option>
        </select>
        <div id="wrapper-tgl-selesai" class="<%= proyek.status === 'Selesai' ? 'flex' : 'hidden' %> items-center space-x-1">
          <span class="text-xs text-slate-500">Tgl:</span>
          <input type="date" name="tanggal_selesai" value="<%= proyek.tanggal_selesai || new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' }) %>" class="px-2.5 py-1.5 bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-900">
        </div>
        <button type="submit" class="px-3.5 py-1.5 bg-slate-900 text-white text-xs font-semibold rounded-lg hover:bg-slate-800">
          Simpan
        </button>
      </form>
    </div>

    <!-- Pindah Cabang -->
    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-3">
      <h3 class="text-sm font-bold text-slate-900">Cabang</h3>
      <form action="/proyek/<%= proyek.id %>/pindah-cabang" method="POST" class="flex items-center space-x-2">
        <select name="cabang_id" class="px-3 py-1.5 bg-slate-50 border border-slate-300 rounded-lg text-xs font-semibold text-slate-900">
          <% cabangList.forEach(c => { %>
            <option value="<%= c.id %>" <%= proyek.cabang_id === c.id ? 'selected' : '' %>><%= c.nama %></option>
          <% }) %>
        </select>
        <button type="submit" class="px-3.5 py-1.5 bg-slate-900 text-white text-xs font-semibold rounded-lg hover:bg-slate-800">
          Pindah
        </button>
      </form>
    </div>

    <!-- Edit Metadata -->
    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-3">
      <h3 class="text-sm font-bold text-slate-900">Spesifikasi</h3>

      <form action="/proyek/<%= proyek.id %>/edit-metadata" method="POST" class="space-y-3 text-xs">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Proyek *</label>
          <input type="text" name="nama" value="<%= proyek.nama %>" placeholder="Nama" required class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-xs focus:bg-white focus:outline-none">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block font-semibold text-slate-700 mb-1">Jenis *</label>
            <select name="jenis_bangunan" required class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-xs focus:bg-white focus:outline-none">
              <% (typeof jenisList !== 'undefined' && jenisList.length > 0 ? jenisList : ['Rumah', 'Ruko', 'Renovasi', 'Gedung', 'Lainnya']).forEach(j => { %>
                <option value="<%= j %>" <%= proyek.jenis_bangunan === j ? 'selected' : '' %>><%= j %></option>
              <% }) %>
              <% if (typeof jenisList !== 'undefined' && !jenisList.includes(proyek.jenis_bangunan)) { %>
                <option value="<%= proyek.jenis_bangunan %>" selected><%= proyek.jenis_bangunan %></option>
              <% } %>
            </select>
          </div>

          <div>
            <label class="block font-semibold text-slate-700 mb-1">Luas (m²)</label>
            <input type="number" name="luas_m2" value="<%= proyek.luas_m2 %>" placeholder="Luas" min="0" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-xs focus:bg-white focus:outline-none">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <div class="flex items-center justify-between mb-1">
              <label for="edit-lokasi" class="block font-semibold text-slate-700">Lokasi</label>
              <button 
                type="button" 
                onclick="lacakLokasiGPS('edit-lokasi')" 
                id="btn-lacak-gps-edit"
                class="text-[11px] font-semibold text-slate-500 hover:text-slate-900 inline-flex items-center space-x-1 transition-colors"
                title="Lacak GPS Lokasi Sekarang"
              >
                <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span id="label-gps-edit-lokasi">GPS</span>
              </button>
            </div>
            <div class="relative">
              <input 
                type="text" 
                id="edit-lokasi" 
                name="lokasi" 
                value="<%= proyek.lokasi || '' %>" 
                placeholder="Lokasi" 
                class="w-full px-3 py-2 pr-7 bg-slate-50 border border-slate-300 rounded-lg text-xs focus:bg-white focus:outline-none"
              >
              <button 
                type="button" 
                onclick="lacakLokasiGPS('edit-lokasi')" 
                class="absolute right-2 top-2 text-slate-400 hover:text-slate-700"
                title="Deteksi Lokasi GPS"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2m0 16v2m10-10h-2M4 12H2m15.071-7.071l-1.414 1.414M6.343 17.657l-1.414 1.414m12.728 0l-1.414-1.414M6.343 6.343L4.929 4.929M12 17a5 5 0 100-10 5 5 0 000 10z"></path>
                </svg>
              </button>
            </div>
            <div id="status-gps-edit-lokasi" class="text-[10px] text-slate-400 mt-1 hidden truncate"></div>
          </div>

          <div>
            <label class="block font-semibold text-slate-700 mb-1">Tanggal *</label>
            <input type="date" name="tanggal_mulai" value="<%= proyek.tanggal_mulai %>" required class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-xs focus:bg-white focus:outline-none">
          </div>
        </div>

        <div>
          <button type="submit" class="px-4 py-2 bg-slate-900 text-white font-semibold rounded-lg hover:bg-slate-800">
            Simpan
          </button>
        </div>
      </form>
    </div>

  </div>

</div>

<!-- ========================================================================= -->
<!-- FLOATING ACTION BUTTON (AKSI CEPAT MELAYANG DI KANAN BAWAH) -->
<!-- ========================================================================= -->
<% if (proyek.status === 'Aktif') { %>
  <div id="fab-catat-belanja" class="fixed bottom-5 right-5 z-30">
    <button 
      type="button"
      onclick="openModal('modal-pengeluaran')" 
      class="inline-flex items-center space-x-2 px-4 py-3 bg-slate-900 text-white rounded-full shadow-xl hover:bg-slate-800 hover:scale-105 active:scale-95 transition-all focus:outline-none focus:ring-4 focus:ring-slate-900/20"
      title="Catat Belanja Langsung (Tekan tombol B)"
    >
      <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
      <span class="text-xs font-bold tracking-wide pr-1">Catat Belanja</span>
    </button>
  </div>
<% } %>

<!-- ========================================================================= -->
<!-- MODAL AKSI (SUPER SIMPEL & USER FRIENDLY) -->
<!-- ========================================================================= -->

<!-- MODAL: AKHIRI PROYEK (PINDAHKAN KE HISTORI & CATAT TANGGAL BERAKHIR OTOMATIS) -->
<div id="modal-akhiri-proyek" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full p-5 sm:p-6 border border-slate-200 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-slate-900 leading-snug">Akhiri Proyek</h3>
          <p class="text-[11px] text-slate-400">Pindahkan proyek ke Histori</p>
        </div>
      </div>
      <button type="button" onclick="closeModal('modal-akhiri-proyek')" class="p-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Ringkasan Keuangan Akhir Proyek -->
    <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl mb-4 space-y-1.5 text-xs">
      <div class="flex justify-between items-center">
        <span class="text-slate-500">Nama:</span>
        <span class="font-bold text-slate-900 truncate max-w-[180px]"><%= proyek.nama %></span>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-slate-500">Mulai:</span>
        <span class="font-mono text-slate-700"><%= proyek.tanggal_mulai %></span>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-slate-500">Modal Bersih:</span>
        <span class="font-mono font-medium text-slate-800">Rp<%= saldo.modalBersih.toLocaleString('id-ID') %></span>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-slate-500">Total Belanja:</span>
        <span class="font-mono font-bold text-slate-900">Rp<%= saldo.biayaTerealisasi.toLocaleString('id-ID') %></span>
      </div>
      <div class="flex justify-between items-center pt-1.5 border-t border-slate-200">
        <span class="font-bold text-slate-700">Sisa Kas Akhir:</span>
        <span class="font-mono font-extrabold <%= saldo.isKasMinus ? 'text-rose-600' : 'text-emerald-700' %>">
          Rp<%= saldo.saldoKas.toLocaleString('id-ID') %>
        </span>
      </div>
    </div>

    <form action="/proyek/<%= proyek.id %>/akhiri" method="POST" class="space-y-3.5">
      <!-- Tanggal Berakhir Otomatis (WIB Hari Ini) -->
      <div>
        <label for="tanggal_selesai_input" class="block text-xs font-semibold text-slate-700 mb-1">
          Tanggal Berakhir Proyek
        </label>
        <input 
          type="date" 
          id="tanggal_selesai_input" 
          name="tanggal_selesai" 
          value="<%= new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' }) %>"
          min="<%= proyek.tanggal_mulai %>"
          required 
          class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs bg-slate-50 font-medium text-slate-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-slate-900"
        >
        <span class="text-[10px] text-slate-400 mt-1 block">Tercatat otomatis hari ini, dapat disesuaikan jika proyek selesai lebih awal.</span>
      </div>

      <!-- Catatan Penutupan -->
      <div>
        <label for="catatan_selesai_input" class="block text-xs font-semibold text-slate-700 mb-1">
          Catatan Penutupan (Opsional)
        </label>
        <textarea 
          id="catatan_selesai_input" 
          name="catatan_selesai" 
          rows="2"
          placeholder="Misal: Serah terima kunci selesai, pekerjaan rampung..."
          class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs bg-slate-50 text-slate-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-slate-900"
        ></textarea>
      </div>

      <div class="pt-2 flex items-center space-x-2">
        <button 
          type="button" 
          onclick="closeModal('modal-akhiri-proyek')" 
          class="flex-1 py-2 text-xs font-semibold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors"
        >
          Batal
        </button>
        <button 
          type="submit" 
          class="flex-1 py-2 text-xs font-bold text-white bg-slate-900 hover:bg-slate-800 rounded-xl transition-all shadow-sm"
        >
          Konfirmasi Akhiri
        </button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL 1: CATAT BELANJA (HANYA NAMA PENGELUARAN & NOMINAL) -->
<div id="modal-pengeluaran" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full p-5 sm:p-6 border border-slate-200 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
      <div class="flex items-center space-x-2">
        <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
        <h3 class="text-sm font-bold text-slate-900">Belanja</h3>
      </div>
      <button onclick="closeModal('modal-pengeluaran')" class="text-slate-400 hover:text-slate-700 text-xl font-bold p-1 leading-none">&times;</button>
    </div>

    <form action="/proyek/<%= proyek.id %>/belanja" method="POST" data-idempotent class="space-y-3.5 text-xs">
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Pengeluaran *</label>
        <input 
          type="text" 
          id="belanja-uraian-input"
          name="uraian" 
          placeholder="Uraian" 
          required 
          autofocus
          autocomplete="off"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
        >
        <!-- Indikator Kategori Otomatis Realtime -->
        <div id="live-kategori-badge" class="mt-1.5 hidden"></div>
      </div>

      <!-- Kategori Kustom / Pilihan / Tambah Baru -->
      <div>
        <label for="belanja-kategori-select" class="block font-semibold text-slate-700 mb-1">Kategori</label>
        <select 
          id="belanja-kategori-select" 
          name="kategori_id" 
          onchange="handleKategoriSelect(this)" 
          class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs bg-white text-slate-800 focus:outline-none focus:ring-1 focus:ring-slate-900"
        >
          <option value="">Otomatis</option>
          <% kategoriList.forEach(k => { %>
            <option value="<%= k.id %>"><%= k.nama %></option>
          <% }) %>
          <option value="__BARU__" class="font-bold text-emerald-700 bg-emerald-50">+ Tambah</option>
        </select>

        <!-- Input Kategori Baru -->
        <div id="container-kategori-baru" class="hidden mt-2 p-2 bg-slate-50 border border-slate-200 rounded-xl space-y-1">
          <label for="input-kategori-baru" class="block font-bold text-slate-800 text-[11px]">
            Kategori Baru *
          </label>
          <input 
            type="text" 
            id="input-kategori-baru" 
            name="kategori_baru" 
            placeholder="Kategori" 
            class="w-full px-2.5 py-1.5 border border-slate-300 rounded-lg text-xs bg-white focus:outline-none focus:ring-1 focus:ring-slate-900"
          >
        </div>
      </div>

      <div>
        <label class="block font-semibold text-slate-700 mb-1">Nominal (Rp) *</label>
        <input 
          type="text" 
          inputmode="numeric"
          name="nominal" 
          placeholder="Nominal" 
          required 
          autocomplete="off"
          class="currency-input w-full px-3 py-2.5 border border-slate-300 rounded-xl text-xs font-mono font-bold focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-slate-900"
        >
        <!-- Tombol Tambah Nominal Cepat -->
        <div class="flex flex-wrap items-center gap-1.5 pt-1.5">
          <button type="button" onclick="tambahNominal('modal-pengeluaran', 50000)" class="px-2 py-0.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-[10px] font-mono font-medium rounded transition-colors">+50 rb</button>
          <button type="button" onclick="tambahNominal('modal-pengeluaran', 100000)" class="px-2 py-0.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-[10px] font-mono font-medium rounded transition-colors">+100 rb</button>
          <button type="button" onclick="tambahNominal('modal-pengeluaran', 500000)" class="px-2 py-0.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-[10px] font-mono font-medium rounded transition-colors">+500 rb</button>
          <button type="button" onclick="tambahNominal('modal-pengeluaran', 1000000)" class="px-2 py-0.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-[10px] font-mono font-medium rounded transition-colors">+1 jt</button>
          <button type="button" onclick="tambahNominal('modal-pengeluaran', 0)" class="px-1.5 py-0.5 bg-rose-50 hover:bg-rose-100 text-rose-600 text-[10px] font-medium rounded transition-colors">Reset</button>
        </div>
      </div>

      <div>
        <label class="block font-semibold text-slate-700 mb-1">Jumlah</label>
        <input 
          type="text" 
          name="jumlah" 
          placeholder="Contoh: 10 sak, 50 biji (opsional)" 
          autocomplete="off"
          class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
        >
      </div>

      <div>
        <label class="block font-semibold text-slate-700 mb-1">Toko</label>
        <input 
          type="text" 
          name="vendor" 
          placeholder="Toko" 
          class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
        >
      </div>

      <input type="hidden" name="tanggal" value="<%= new Date().toISOString().split('T')[0] %>">

      <div class="flex justify-end space-x-2 pt-3 border-t border-slate-100">
        <button type="button" onclick="closeModal('modal-pengeluaran')" class="px-3.5 py-2 font-semibold text-slate-500 rounded-xl hover:bg-slate-100 transition-colors">Batal</button>
        <button type="submit" class="px-5 py-2 font-semibold text-white bg-slate-900 rounded-xl hover:bg-slate-800 shadow-sm transition-colors">Simpan</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL 2: KELOLA MODAL -->
<div id="modal-kelola-modal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full p-5 sm:p-6 border border-slate-200 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
      <h3 class="text-sm font-bold text-slate-900">Modal</h3>
      <button onclick="closeModal('modal-kelola-modal')" class="text-slate-400 hover:text-slate-700 text-xl font-bold p-1 leading-none">&times;</button>
    </div>

    <form action="/proyek/<%= proyek.id %>/modal" method="POST" data-idempotent class="space-y-3.5 text-xs">
      <div class="grid grid-cols-2 gap-2">
        <label class="flex items-center justify-center space-x-2 p-2.5 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 transition-colors">
          <input type="radio" name="tipe" value="MASUK" checked class="text-slate-900 focus:ring-0">
          <span class="font-bold text-slate-800">Setor (+)</span>
        </label>
        <label class="flex items-center justify-center space-x-2 p-2.5 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 transition-colors">
          <input type="radio" name="tipe" value="PENARIKAN" class="text-slate-900 focus:ring-0">
          <span class="font-bold text-slate-800">Tarik (-)</span>
        </label>
      </div>

      <div>
        <label class="block font-semibold text-slate-700 mb-1">Nominal (Rp) *</label>
        <input 
          type="text" 
          inputmode="numeric"
          name="nominal" 
          placeholder="Nominal" 
          required 
          autocomplete="off"
          class="currency-input w-full px-3 py-2.5 border border-slate-300 rounded-xl text-xs font-mono font-bold focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-slate-900"
        >
        <!-- Tombol Cepat Nominal Modal -->
        <div class="flex flex-wrap items-center gap-1.5 pt-1.5">
          <button type="button" onclick="tambahNominal('modal-kelola-modal', 5000000)" class="px-2 py-0.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-[10px] font-mono font-medium rounded transition-colors">+5 jt</button>
          <button type="button" onclick="tambahNominal('modal-kelola-modal', 10000000)" class="px-2 py-0.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-[10px] font-mono font-medium rounded transition-colors">+10 jt</button>
          <button type="button" onclick="tambahNominal('modal-kelola-modal', 25000000)" class="px-2 py-0.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-[10px] font-mono font-medium rounded transition-colors">+25 jt</button>
          <button type="button" onclick="tambahNominal('modal-kelola-modal', 50000000)" class="px-2 py-0.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-[10px] font-mono font-medium rounded transition-colors">+50 jt</button>
          <button type="button" onclick="tambahNominal('modal-kelola-modal', 0)" class="px-1.5 py-0.5 bg-rose-50 hover:bg-rose-100 text-rose-600 text-[10px] font-medium rounded transition-colors">Reset</button>
        </div>
      </div>

      <div>
        <label class="block font-semibold text-slate-700 mb-1">Uraian</label>
        <input type="text" name="uraian" placeholder="Uraian" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-slate-900">
      </div>

      <input type="hidden" name="tanggal" value="<%= new Date().toISOString().split('T')[0] %>">

      <div class="flex justify-end space-x-2 pt-3 border-t border-slate-100">
        <button type="button" onclick="closeModal('modal-kelola-modal')" class="px-3.5 py-2 font-semibold text-slate-500 rounded-xl hover:bg-slate-100 transition-colors">Batal</button>
        <button type="submit" class="px-5 py-2 font-semibold text-white bg-slate-900 rounded-xl hover:bg-slate-800 shadow-sm transition-colors">Simpan</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL 3: BATAL TRANSAKSI -->
<div id="modal-batal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full p-5 sm:p-6 border border-slate-200 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
      <h3 class="text-sm font-bold text-rose-700">Batalkan</h3>
      <button onclick="closeModal('modal-batal')" class="text-slate-400 hover:text-slate-700 text-xl font-bold p-1 leading-none">&times;</button>
    </div>

    <form id="form-batal-transaksi" method="POST" class="space-y-3.5 text-xs">
      <p class="text-slate-600">
        Batalkan: <strong id="modal-batal-info"></strong>
      </p>

      <div>
        <label class="block font-semibold text-slate-700 mb-1">Alasan *</label>
        <input type="text" name="alasan" placeholder="Alasan" required minlength="3" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-rose-500">
      </div>

      <div class="flex justify-end space-x-2 pt-3 border-t border-slate-100">
        <button type="button" onclick="closeModal('modal-batal')" class="px-3.5 py-2 font-semibold text-slate-500 rounded-xl hover:bg-slate-100">Batal</button>
        <button type="submit" class="px-4 py-2 font-semibold text-white bg-rose-600 rounded-xl hover:bg-rose-700 transition-colors">Batalkan</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL 4: EDIT TRANSAKSI -->
<div id="modal-edit-tx" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full p-5 sm:p-6 border border-slate-200 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
      <h3 class="text-sm font-bold text-slate-900">Edit</h3>
      <button onclick="closeModal('modal-edit-tx')" class="text-slate-400 hover:text-slate-700 text-xl font-bold p-1 leading-none">&times;</button>
    </div>

    <form id="form-edit-tx" method="POST" class="space-y-3.5 text-xs">
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Uraian *</label>
        <input type="text" id="modal-edit-uraian" name="uraian" placeholder="Uraian" required minlength="3" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-slate-900">
      </div>

      <div>
        <label class="block font-semibold text-slate-700 mb-1">Jumlah</label>
        <input type="text" id="modal-edit-jumlah" name="jumlah" placeholder="Contoh: 10 sak, 50 biji (opsional)" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-slate-900">
      </div>

      <div>
        <label class="block font-semibold text-slate-700 mb-1">Toko</label>
        <input type="text" id="modal-edit-vendor" name="vendor" placeholder="Toko" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-slate-900">
      </div>

      <div class="flex justify-end space-x-2 pt-3 border-t border-slate-100">
        <button type="button" onclick="closeModal('modal-edit-tx')" class="px-3.5 py-2 font-semibold text-slate-500 rounded-xl hover:bg-slate-100">Batal</button>
        <button type="submit" class="px-4 py-2 font-semibold text-white bg-slate-900 rounded-xl hover:bg-slate-800 transition-colors">Simpan</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL 5: ATUR PAGU -->
<div id="modal-anggaran" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full p-5 sm:p-6 border border-slate-200 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
      <h3 class="text-sm font-bold text-slate-900">Pagu</h3>
      <button onclick="closeModal('modal-anggaran')" class="text-slate-400 hover:text-slate-700 text-xl font-bold p-1 leading-none">&times;</button>
    </div>

    <form action="/proyek/<%= proyek.id %>/anggaran" method="POST" class="space-y-3.5 text-xs">
      <input type="hidden" id="modal-anggaran-kat-id" name="kategori_id">

      <div>
        <label class="block font-semibold text-slate-700 mb-1"><strong id="modal-anggaran-nama"></strong></label>
        <input 
          type="text" 
          inputmode="numeric" 
          id="modal-anggaran-pagu" 
          name="pagu_anggaran" 
          placeholder="Pagu" 
          required 
          autocomplete="off"
          class="currency-input w-full px-3 py-2.5 border border-slate-300 rounded-xl text-xs font-mono font-bold focus:outline-none focus:ring-1 focus:ring-slate-900"
        >
      </div>

      <div class="flex justify-end space-x-2 pt-3 border-t border-slate-100">
        <button type="button" onclick="closeModal('modal-anggaran')" class="px-3.5 py-2 font-semibold text-slate-500 rounded-xl hover:bg-slate-100">Batal</button>
        <button type="submit" class="px-4 py-2 font-semibold text-white bg-slate-900 rounded-xl hover:bg-slate-800 transition-colors">Simpan</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL 6: TAMBAH KATEGORI -->
<div id="modal-tambah-kategori" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full p-5 sm:p-6 border border-slate-200 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
      <h3 class="text-sm font-bold text-slate-900">Kategori Baru</h3>
      <button onclick="closeModal('modal-tambah-kategori')" class="text-slate-400 hover:text-slate-700 text-xl font-bold p-1 leading-none">&times;</button>
    </div>

    <form action="/kategori" method="POST" class="space-y-3.5 text-xs">
      <input type="hidden" name="proyek_id" value="<%= proyek.id %>">

      <div>
        <label class="block font-semibold text-slate-700 mb-1">Kategori *</label>
        <input type="text" name="nama" placeholder="Kategori" required class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-slate-900">
      </div>

      <div class="flex justify-end space-x-2 pt-3 border-t border-slate-100">
        <button type="button" onclick="closeModal('modal-tambah-kategori')" class="px-3.5 py-2 font-semibold text-slate-500 rounded-xl hover:bg-slate-100">Batal</button>
        <button type="submit" class="px-4 py-2 font-semibold text-white bg-slate-900 rounded-xl hover:bg-slate-800 transition-colors">Simpan</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL 7: SALIN ANGGARAN -->
<div id="modal-salin-anggaran" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full p-5 sm:p-6 border border-slate-200 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
      <h3 class="text-sm font-bold text-slate-900">Salin Anggaran</h3>
      <button onclick="closeModal('modal-salin-anggaran')" class="text-slate-400 hover:text-slate-700 text-xl font-bold p-1 leading-none">&times;</button>
    </div>

    <form action="/proyek/<%= proyek.id %>/salin-anggaran" method="POST" class="space-y-3.5 text-xs">
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Proyek Asal</label>
        <select name="sumber_proyek_id" required class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs bg-white focus:outline-none focus:ring-1 focus:ring-slate-900">
          <% if (typeof otherProjects !== 'undefined') { %>
            <% otherProjects.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.nama %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <div class="flex justify-end space-x-2 pt-3 border-t border-slate-100">
        <button type="button" onclick="closeModal('modal-salin-anggaran')" class="px-3.5 py-2 font-semibold text-slate-500 rounded-xl hover:bg-slate-100">Batal</button>
        <button type="submit" class="px-4 py-2 font-semibold text-white bg-slate-900 rounded-xl hover:bg-slate-800 transition-colors">Salin</button>
      </div>
    </form>
  </div>
</div>

<script>
  function pilihFilterJenis(val) {
    const input = document.getElementById('filter-jenis-val');
    if (input) {
      input.value = val;
      input.form.submit();
    }
  }

  function bukaModalBatal(transaksiId, jenis, nominal) {
    const form = document.getElementById('form-batal-transaksi');
    form.action = `/proyek/<%= proyek.id %>/transaksi/${transaksiId}/batal`;
    document.getElementById('modal-batal-info').innerText = `${jenis} (Rp${Number(nominal).toLocaleString('id-ID')})`;
    openModal('modal-batal');
  }

  function bukaModalEditTxBtn(btn) {
    const form = document.getElementById('form-edit-tx');
    form.action = `/proyek/<%= proyek.id %>/transaksi/${btn.dataset.id}/edit`;
    document.getElementById('modal-edit-uraian').value = btn.dataset.uraian || '';
    document.getElementById('modal-edit-vendor').value = btn.dataset.vendor || '';
    const elJml = document.getElementById('modal-edit-jumlah');
    if (elJml) elJml.value = btn.dataset.jumlah || '';
    openModal('modal-edit-tx');
  }

  function bukaModalAnggaran(kategoriId, namaKategori, paguSaatIni) {
    document.getElementById('modal-anggaran-kat-id').value = kategoriId;
    document.getElementById('modal-anggaran-nama').innerText = namaKategori;
    document.getElementById('modal-anggaran-pagu').value = typeof formatAngkaTitik === 'function' ? formatAngkaTitik(paguSaatIni) : paguSaatIni;
    openModal('modal-anggaran');
  }

  function toggleTanggalSelesaiInput(val) {
    const el = document.getElementById('wrapper-tgl-selesai');
    if (el) {
      if (val === 'Selesai') {
        el.classList.remove('hidden');
        el.classList.add('flex');
      } else {
        el.classList.add('hidden');
        el.classList.remove('flex');
      }
    }
  }
</script>

                <tr class="hover:bg-slate-50/80 transition-colors <%= t.is_cancelled ? 'bg-slate-50/60 opacity-60' : '' %>">
                  <td class="py-3 px-3.5 font-mono whitespace-nowrap text-slate-500">
                    <%= t.tanggal_transaksi %>
                  </td>
                  <td class="py-3 px-3.5 whitespace-nowrap">

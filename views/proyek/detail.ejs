              <th class="py-3 px-3.5">Kategori</th>
              <th class="py-3 px-3.5 text-right">Pagu</th>
              <th class="py-3 px-3.5 text-right">Realisasi</th>
              <th class="py-3 px-3.5 text-right">Sisa</th>
              <th class="py-3 px-3.5 text-center">Status</th>
              <th class="py-3 px-3.5 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-800">
            <% anggaranList.forEach(item => { %>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="py-3 px-3.5 font-bold text-slate-900">
                  <%= item.nama %>
                </td>
                <td class="py-3 px-3.5 text-right font-mono">
                  Rp<%= item.pagu_anggaran.toLocaleString('id-ID') %>
                </td>
                <td class="py-3 px-3.5 text-right font-mono font-bold text-slate-900">
                  Rp<%= item.realisasi.toLocaleString('id-ID') %>
                </td>
                <td class="py-3 px-3.5 text-right font-mono <%= item.sisa_anggaran < 0 ? 'text-rose-700 font-bold' : 'text-slate-600' %>">
                  Rp<%= item.sisa_anggaran.toLocaleString('id-ID') %>
                </td>
                <td class="py-3 px-3.5 text-center">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold border <%= item.badgeClass %>">
                    <%= item.status %> (<%= item.persentase %>%)
                  </span>
                </td>
                <td class="py-3 px-3.5 text-right">
                  <button 
                    onclick="bukaModalAnggaran(<%= item.kategori_id %>, '<%= item.nama %>', <%= item.pagu_anggaran %>)"
                    class="px-2.5 py-1 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors"
                  >
                    Atur
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Feed Anggaran (Mobile View - Khusus Layar HP) -->
    <div class="md:hidden space-y-2.5">
      <% anggaranList.forEach(item => { %>
        <div class="bg-white border border-slate-200 rounded-xl p-3 shadow-xs space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-bold text-slate-900 text-xs"><%= item.nama %></span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold border <%= item.badgeClass %>">
              <%= item.status %> (<%= item.persentase %>%)
            </span>
          </div>

          <div class="grid grid-cols-3 gap-1 text-center bg-slate-50/80 p-2 rounded-lg border border-slate-100 text-[10px]">
            <div>
              <span class="text-slate-400 block text-[9px] uppercase">Pagu</span>
              <span class="font-mono font-bold text-slate-800">Rp<%= item.pagu_anggaran.toLocaleString('id-ID') %></span>
            </div>
            <div>
              <span class="text-slate-400 block text-[9px] uppercase">Realisasi</span>
              <span class="font-mono font-bold text-slate-900">Rp<%= item.realisasi.toLocaleString('id-ID') %></span>
            </div>
            <div>
              <span class="text-slate-400 block text-[9px] uppercase">Sisa</span>
              <span class="font-mono font-bold <%= item.sisa_anggaran < 0 ? 'text-rose-700' : 'text-slate-700' %>">
                Rp<%= item.sisa_anggaran.toLocaleString('id-ID') %>
              </span>
            </div>
          </div>

          <div class="flex justify-end pt-0.5">
            <button 
              onclick="bukaModalAnggaran(<%= item.kategori_id %>, '<%= item.nama %>', <%= item.pagu_anggaran %>)"
              class="px-3 py-1 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors"
            >
              Atur Pagu
            </button>
          </div>
        </div>
      <% }) %>
    </div>

  </div>

  <!-- TAB 3: ESTIMASI / m² -->
  <div id="tab-patokan" class="tab-content <%= activeTab === 'patokan' ? '' : 'hidden' %> space-y-3">
    
    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-3">
      <div>
        <h3 class="text-sm font-bold text-slate-900">Patokan Biaya Konstruksi per m²</h3>

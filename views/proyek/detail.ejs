                      <span class="px-1.5 py-0.5 text-[10px] font-bold rounded bg-slate-200 text-slate-700 line-through">
                        Batal
                      </span>
                    <% } else { %>
                      <span class="px-2 py-0.5 text-[10px] font-bold rounded-full 
                        <%= t.jenis_transaksi === 'MODAL_MASUK' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : '' %>
                        <%= t.jenis_transaksi === 'PENARIKAN_MODAL' ? 'bg-amber-50 text-amber-800 border border-amber-200' : '' %>
                        <%= t.jenis_transaksi === 'PENGELUARAN_LANGSUNG' || t.jenis_transaksi === 'NOTA_PANJAR' ? 'bg-slate-100 text-slate-800 border border-slate-200' : '' %>
                      ">
                        <%= t.jenis_transaksi === 'MODAL_MASUK' ? 'Modal' : (t.jenis_transaksi === 'PENARIKAN_MODAL' ? 'Tarik' : 'Belanja') %>
                      </span>
                    <% } %>
                  </td>
                  <td class="py-3 px-3.5 whitespace-nowrap font-medium text-slate-900">
                    <%= t.nama_kategori || '-' %>
                  </td>
                  <td class="py-3 px-3.5 <%= t.is_cancelled ? 'line-through text-slate-400' : '' %>">
                    <span class="font-medium text-slate-900"><%= t.uraian %></span>
                    <% if (t.jumlah) { %>
                      <span class="inline-block ml-1.5 px-2 py-0.5 text-[10px] font-semibold bg-slate-100 text-slate-700 rounded-md border border-slate-200"><%= t.jumlah %></span>
                    <% } %>
                    <% if (t.vendor) { %>
                      <span class="text-[11px] text-slate-400 block"><%= t.vendor %></span>
                    <% } %>
                    <% if (t.is_cancelled) { %>
                      <span class="text-[10px] text-rose-600 block no-underline italic">Alasan: <%= t.cancel_reason %></span>
                    <% } %>
                  </td>
                  <td class="py-3 px-3.5 text-right font-mono font-bold whitespace-nowrap <%= t.is_cancelled ? 'line-through text-slate-400' : (t.jenis_transaksi === 'MODAL_MASUK' ? 'text-emerald-700' : 'text-slate-900') %>">
                    <%= t.jenis_transaksi === 'MODAL_MASUK' ? '+' : '-' %>Rp<%= Number(t.nominal).toLocaleString('id-ID') %>
                  </td>
                  <td class="py-3 px-3.5 text-right font-mono whitespace-nowrap text-slate-600">
                    <%= runningBalanceMap[t.id] !== undefined ? 'Rp' + Number(runningBalanceMap[t.id]).toLocaleString('id-ID') : '-' %>
                  </td>
                  <td class="py-3 px-3.5 text-right whitespace-nowrap">
                    <% if (!t.is_cancelled && proyek.status === 'Aktif') { %>
                      <div class="flex items-center justify-end space-x-2">
                        <button 
                          type="button"
                          data-id="<%= t.id %>"
                          data-uraian="<%= t.uraian %>"
                          data-vendor="<%= t.vendor || '' %>"
                          data-jumlah="<%= t.jumlah || '' %>"
                          onclick="bukaModalEditTxBtn(this)"
                          class="text-xs font-semibold text-slate-600 hover:text-slate-900"
                        >
                          Edit
                        </button>
                        <button 
                          onclick="bukaModalBatal(<%= t.id %>, '<%= t.jenis_transaksi %>', <%= t.nominal %>)"
                          class="text-xs font-semibold text-rose-600 hover:text-rose-800"
                        >
                          Batal
                        </button>
                      </div>
                    <% } else { %>
                      <span class="text-slate-300">-</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
          <% if (transaksiList.length > 0) { %>
            <tfoot class="bg-slate-50 border-t-2 border-slate-200 font-bold text-slate-800">
              <tr>
                <td colspan="4" class="py-3 px-3.5 text-right uppercase text-[11px] tracking-wider text-slate-600">
                  <% if (filterKategori && namaFilterKategori) { %>
                    Total Kategori <%= namaFilterKategori %>:
                  <% } else { %>
                    Total Belanja Terdaftar:
                  <% } %>
                </td>
                <td class="py-3 px-3.5 text-right font-mono font-extrabold text-sm <%= filterKategori ? 'text-emerald-700' : 'text-slate-900' %>">
                  <% if (filterKategori) { %>
                    Rp<%= totalFilterKategori.toLocaleString('id-ID') %>
                  <% } else { %>
                    <% const totalPLDesk = transaksiList.filter(t => !t.is_cancelled && (t.jenis_transaksi === 'PENGELUARAN_LANGSUNG' || t.jenis_transaksi === 'NOTA_PANJAR')).reduce((acc, curr) => acc + Number(curr.nominal), 0); %>
                    Rp<%= totalPLDesk.toLocaleString('id-ID') %>
                  <% } %>
                </td>
                <td colspan="2" class="py-3 px-3.5 text-slate-400 text-[11px] font-normal">
                  (<%= transaksiList.filter(t => !t.is_cancelled).length %> Transaksi)
                </td>
              </tr>
            </tfoot>
          <% } %>
        </table>
      </div>
    </div>

    <!-- Mutasi Kas: Mobile Feed View (Khusus Layar HP - Sangat Mudah Dibaca) -->
    <div id="buku-kas-mobile" class="md:hidden space-y-2.5">
      <% if (transaksiList.length === 0) { %>
        <div class="bg-white border border-slate-200 rounded-xl p-8 text-center text-xs text-slate-400">
          Belum ada transaksi di proyek ini.
        </div>
      <% } else { %>
        <% transaksiList.forEach(t => { %>
          <div class="buku-kas-card bg-white border border-slate-200 rounded-xl p-3.5 shadow-sm space-y-2 <%= t.is_cancelled ? 'bg-slate-50/70 opacity-60' : '' %>">
            <div class="flex items-center justify-between text-xs">
              <div class="flex items-center space-x-2">
                <span class="font-mono text-slate-400 text-[11px]"><%= t.tanggal_transaksi %></span>
                <span class="text-slate-300">•</span>
                <span class="font-semibold text-slate-800 text-[11px]"><%= t.nama_kategori || '-' %></span>
              </div>
              
              <div>
                <% if (t.is_cancelled) { %>
                  <span class="px-1.5 py-0.5 text-[10px] font-bold rounded bg-slate-200 text-slate-700 line-through">Batal</span>
                <% } else { %>
                  <span class="px-2 py-0.5 text-[10px] font-bold rounded-full 
                    <%= t.jenis_transaksi === 'MODAL_MASUK' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : '' %>
                    <%= t.jenis_transaksi === 'PENARIKAN_MODAL' ? 'bg-amber-50 text-amber-800 border border-amber-200' : '' %>
                    <%= t.jenis_transaksi === 'PENGELUARAN_LANGSUNG' || t.jenis_transaksi === 'NOTA_PANJAR' ? 'bg-slate-100 text-slate-800 border border-slate-200' : '' %>
                  ">
                    <%= t.jenis_transaksi === 'MODAL_MASUK' ? 'Modal' : (t.jenis_transaksi === 'PENARIKAN_MODAL' ? 'Tarik' : 'Belanja') %>
                  </span>
                <% } %>
              </div>
            </div>

            <div class="flex items-start justify-between gap-3 pt-0.5">
              <div class="<%= t.is_cancelled ? 'line-through text-slate-400' : '' %>">
                <div class="text-xs font-bold text-slate-900 leading-snug">
                  <%= t.uraian %>
                  <% if (t.jumlah) { %>
                    <span class="inline-block ml-1 px-1.5 py-0.2 text-[10px] font-semibold bg-slate-100 text-slate-700 rounded border border-slate-200"><%= t.jumlah %></span>
                  <% } %>
                </div>
                <% if (t.vendor) { %>
                  <div class="text-[11px] text-slate-400 mt-0.5 flex items-center space-x-1">
                    <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                    <span><%= t.vendor %></span>
                  </div>
                <% } %>
                <% if (t.is_cancelled) { %>
                  <div class="text-[10px] text-rose-600 no-underline italic mt-0.5">Alasan: <%= t.cancel_reason %></div>
                <% } %>
              </div>

              <div class="text-right shrink-0">
                <div class="text-sm font-extrabold font-mono <%= t.is_cancelled ? 'line-through text-slate-400' : (t.jenis_transaksi === 'MODAL_MASUK' ? 'text-emerald-700' : 'text-slate-900') %>">
                  <%= t.jenis_transaksi === 'MODAL_MASUK' ? '+' : '-' %>Rp<%= Number(t.nominal).toLocaleString('id-ID') %>
                </div>
                <div class="text-[10px] font-mono text-slate-400 mt-0.5">
                  Saldo: <%= runningBalanceMap[t.id] !== undefined ? 'Rp' + Number(runningBalanceMap[t.id]).toLocaleString('id-ID') : '-' %>
                </div>
              </div>
            </div>

            <% if (!t.is_cancelled && proyek.status === 'Aktif') { %>
              <div class="flex items-center justify-end space-x-3 pt-2 border-t border-slate-100 text-xs">
                <button 
                  type="button"
                  data-id="<%= t.id %>"
                  data-uraian="<%= t.uraian %>"
                  data-vendor="<%= t.vendor || '' %>"
                  data-jumlah="<%= t.jumlah || '' %>"
                  onclick="bukaModalEditTxBtn(this)"
                  class="font-semibold text-slate-600 hover:text-slate-900 py-0.5"
                >
                  Edit
                </button>
                <button 
                  onclick="bukaModalBatal(<%= t.id %>, '<%= t.jenis_transaksi %>', <%= t.nominal %>)"
                  class="font-semibold text-rose-600 hover:text-rose-800 py-0.5"
                >
                  Batal
                </button>
              </div>
            <% } %>
          </div>
        <% }) %>
        <!-- Ringkasan Total Belanja / Filter Kategori Mobile -->
        <div class="bg-white border border-slate-200 rounded-xl p-3 flex items-center justify-between text-xs shadow-sm">
          <span class="font-semibold text-slate-600">
            <% if (filterKategori && namaFilterKategori) { %>
              Total Kategori <%= namaFilterKategori %>
            <% } else { %>
              Total Belanja Terdaftar
            <% } %>
          </span>
          <span class="font-mono font-extrabold text-sm <%= filterKategori ? 'text-emerald-700' : 'text-slate-900' %>">
            <% if (filterKategori) { %>
              Rp<%= totalFilterKategori.toLocaleString('id-ID') %>
            <% } else { %>
              <% const totalPLMob = transaksiList.filter(t => !t.is_cancelled && (t.jenis_transaksi === 'PENGELUARAN_LANGSUNG' || t.jenis_transaksi === 'NOTA_PANJAR')).reduce((acc, curr) => acc + Number(curr.nominal), 0); %>
              Rp<%= totalPLMob.toLocaleString('id-ID') %>
            <% } %>
          </span>
        </div>
      <% } %>
    </div>

  </div>

  <!-- TAB 2: ANGGARAN -->
  <div id="tab-anggaran" class="tab-content <%= activeTab === 'anggaran' ? '' : 'hidden' %> space-y-3">
    
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-sm font-bold text-slate-900">Anggaran</h3>
      </div>
      <div class="flex items-center space-x-1.5">
        <% if (typeof otherProjects !== 'undefined' && otherProjects.length > 0) { %>
          <button onclick="openModal('modal-salin-anggaran')" class="px-3 py-1.5 bg-white border border-slate-300 text-slate-700 text-xs font-semibold rounded-lg hover:bg-slate-50 transition-all shadow-sm">
            Salin
          </button>
        <% } %>
        <button onclick="openModal('modal-tambah-kategori')" class="px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg shadow-sm transition-all">
          + Kategori
        </button>
      </div>
    </div>


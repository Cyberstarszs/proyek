              <div>
                <span class="font-bold text-slate-900"><%= a.aksi %></span>:
                <span class="text-slate-700 ml-1"><%= a.keterangan %></span>
              </div>
              <span class="text-[10px] sm:text-[11px] text-slate-400 font-mono whitespace-nowrap"><%= a.created_at %></span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>

  <!-- TAB 5: PENGATURAN -->
  <div id="tab-pengaturan" class="tab-content <%= activeTab === 'pengaturan' ? '' : 'hidden' %> space-y-4">
    
    <!-- Status -->

<div class="max-w-lg mx-auto space-y-4">

  <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs">
    <form action="/proyek/baru" method="POST" class="space-y-4 text-xs">
      
      <!-- Cabang: Hanya muncul jika ada lebih dari 1 cabang aktif -->
      <% if (cabangList && cabangList.length > 1) { %>
        <div>
          <label for="cabang_id" class="block font-semibold text-slate-700 mb-1">
            Cabang
          </label>
          <select 
            id="cabang_id" 
            name="cabang_id" 
            required 
            class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs bg-white focus:outline-none focus:ring-1 focus:ring-slate-900"
          >
            <option value="" disabled selected>Pilih cabang</option>
            <% cabangList.forEach((c) => { %>
              <option value="<%= c.id %>"><%= c.nama %></option>
            <% }) %>
          </select>
        </div>
      <% } else if (cabangList && cabangList.length === 1) { %>
        <input type="hidden" name="cabang_id" value="<%= cabangList[0].id %>">
      <% } %>

      <!-- Nama Proyek -->
      <div>
        <label for="nama" class="block font-semibold text-slate-700 mb-1">
          Proyek *
        </label>
        <input 
          type="text" 
          id="nama" 
          name="nama" 
          placeholder="Nama" 
          required 
          autofocus
          class="w-full px-3 py-2.5 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
        >
      </div>

      <!-- Jenis Konstruksi -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label class="block font-semibold text-slate-700">
            Jenis *
          </label>
          <button 
            type="button" 
            onclick="toggleTambahJenisKustom()" 
            class="text-[11px] font-bold text-slate-500 hover:text-slate-900 transition-colors"
          >
            + Tambah
          </button>
        </div>
        
        <!-- Pilihan Pills -->
        <div class="flex flex-wrap gap-1.5" id="pills-jenis-bangunan">
          <% (typeof jenisList !== 'undefined' && jenisList.length > 0 ? jenisList : ['Rumah', 'Ruko', 'Renovasi', 'Gedung', 'Lainnya']).forEach((j, idx) => { %>
            <button 
              type="button" 
              onclick="pilihJenisBangunan('<%= j %>')" 
              class="pill-jenis px-3 py-1.5 rounded-lg border text-xs font-semibold transition-all <%= idx === 0 ? 'bg-slate-900 text-white border-slate-900' : 'bg-white text-slate-700 border-slate-300 hover:bg-slate-50' %>"
            >
              <%= j %>
            </button>
          <% }) %>
        </div>

        <!-- Input Jenis Kustom Baru -->
        <div id="container-jenis-kustom" class="hidden mt-1.5 p-2 bg-slate-50 border border-slate-200 rounded-xl flex items-center space-x-2">
          <input 
            type="text" 
            id="input-jenis-kustom" 
            name="jenis_bangunan_kustom" 
            placeholder="Jenis" 
            class="w-full px-2.5 py-1.5 border border-slate-300 rounded-lg text-xs bg-white focus:outline-none focus:ring-1 focus:ring-slate-900"
          >
          <button 
            type="button" 
            onclick="terapkanJenisKustom()" 
            class="px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-lg text-xs whitespace-nowrap transition-colors"
          >
            Gunakan
          </button>
        </div>

        <input 
          type="hidden" 
          id="jenis_bangunan" 
          name="jenis_bangunan" 
          value="<%= (typeof jenisList !== 'undefined' && jenisList[0]) ? jenisList[0] : 'Rumah' %>"
          required
        >
      </div>

      <!-- Luas, Lokasi, Tanggal -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
        <div>
          <label for="luas_m2" class="block font-semibold text-slate-700 mb-1">
            Luas (m²)
          </label>
          <input 
            type="number" 
            id="luas_m2" 
            name="luas_m2" 
            placeholder="Luas" 
            min="0"
            class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
          >
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="lokasi" class="block font-semibold text-slate-700">
              Lokasi
            </label>
            <button 
              type="button" 
              onclick="lacakLokasiGPS()" 
              id="btn-lacak-gps"
              class="text-[11px] font-semibold text-slate-500 hover:text-slate-900 inline-flex items-center space-x-1 transition-colors"
              title="Lacak GPS Lokasi Sekarang"
            >
              <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span id="label-gps">GPS</span>
            </button>
          </div>
          <div class="relative">
            <input 
              type="text" 
              id="lokasi" 
              name="lokasi" 
              placeholder="Lokasi" 
              class="w-full px-3 py-2 pr-7 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
            >
            <button 
              type="button" 
              onclick="lacakLokasiGPS()" 
              class="absolute right-2 top-2 text-slate-400 hover:text-slate-700" 
              title="Deteksi Lokasi GPS"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2m0 16v2m10-10h-2M4 12H2m15.071-7.071l-1.414 1.414M6.343 17.657l-1.414 1.414m12.728 0l-1.414-1.414M6.343 6.343L4.929 4.929M12 17a5 5 0 100-10 5 5 0 000 10z"></path>
              </svg>
            </button>
          </div>
          <div id="status-gps" class="text-[10px] text-slate-400 mt-1 hidden truncate"></div>
        </div>

        <div>
          <label for="tanggal_mulai" class="block font-semibold text-slate-700 mb-1">
            Tanggal *
          </label>
          <input 
            type="date" 
            id="tanggal_mulai" 
            name="tanggal_mulai" 
            value="<%= new Date().toISOString().split('T')[0] %>"
            required 
            class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
          >
        </div>
      </div>

      <!-- Modal Awal Proyek -->
      <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl space-y-2">
        <label for="modal_awal" class="block font-bold text-slate-900 text-xs">
          Modal (Rp) *
        </label>
        <input 
          type="text" 
          id="modal_awal" 
          name="modal_awal" 
          placeholder="Modal" 
          required 
          autocomplete="off"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-xs font-mono font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 bg-white"
        >
        <!-- Tombol Cepat Nominal -->
        <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
          <button type="button" onclick="setNominalInput('modal_awal', 25000000)" class="px-2 py-0.5 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-[10px] font-mono rounded">+25 jt</button>
          <button type="button" onclick="setNominalInput('modal_awal', 50000000)" class="px-2 py-0.5 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-[10px] font-mono rounded">+50 jt</button>
          <button type="button" onclick="setNominalInput('modal_awal', 100000000)" class="px-2 py-0.5 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-[10px] font-mono rounded">+100 jt</button>
          <button type="button" onclick="setNominalInput('modal_awal', 250000000)" class="px-2 py-0.5 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-[10px] font-mono rounded">+250 jt</button>
          <button type="button" onclick="setNominalInput('modal_awal', 0)" class="px-1.5 py-0.5 bg-white hover:bg-rose-50 text-rose-600 border border-rose-200 text-[10px] rounded">Reset</button>
        </div>
      </div>

      <!-- Aksi -->
      <div class="flex items-center justify-end space-x-2 pt-3 border-t border-slate-100">
        <a 
          href="/" 
          class="px-3.5 py-1.5 font-semibold text-slate-500 hover:bg-slate-100 rounded-lg"
        >
          Batal
        </a>
        <button 
          type="submit" 
          class="px-4 py-1.5 font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg shadow-sm"
        >
          Simpan
        </button>
      </div>

    </form>
  </div>

</div>

<script>
  function pilihJenisBangunan(val) {
    const hidden = document.getElementById('jenis_bangunan');
    if (hidden) hidden.value = val;

    const buttons = document.querySelectorAll('#pills-jenis-bangunan .pill-jenis');
    buttons.forEach(btn => {
      if (btn.innerText.trim() === val) {
        btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-300');
        btn.classList.add('bg-slate-900', 'text-white', 'border-slate-900');
      } else {
        btn.classList.remove('bg-slate-900', 'text-white', 'border-slate-900');
        btn.classList.add('bg-white', 'text-slate-700', 'border-slate-300');
      }
    });

    // Kosongkan input kustom jika user memilih pill standar
    const inputKustom = document.getElementById('input-jenis-kustom');
    if (inputKustom && inputKustom.value !== val) {
      inputKustom.value = '';
    }
  }

  function toggleTambahJenisKustom() {
    const container = document.getElementById('container-jenis-kustom');
    const input = document.getElementById('input-jenis-kustom');
    if (container) {
      container.classList.toggle('hidden');
      if (!container.classList.contains('hidden') && input) {
        input.focus();
      }
    }
  }

  function terapkanJenisKustom() {
    const input = document.getElementById('input-jenis-kustom');
    if (!input || !input.value.trim()) {
      if (input) input.focus();
      return;
    }

    const val = input.value.trim();
    const containerPills = document.getElementById('pills-jenis-bangunan');
    
    // Cek apakah pill dengan nama ini sudah ada
    let existingBtn = null;
    const buttons = document.querySelectorAll('#pills-jenis-bangunan .pill-jenis');
    buttons.forEach(b => {
      if (b.innerText.trim().toLowerCase() === val.toLowerCase()) {
        existingBtn = b;
      }
    });

    if (!existingBtn) {
      const newBtn = document.createElement('button');
      newBtn.type = 'button';
      newBtn.className = 'pill-jenis px-3 py-1.5 rounded-lg border text-xs font-semibold transition-all bg-slate-900 text-white border-slate-900';
      newBtn.innerText = val;
      newBtn.onclick = () => pilihJenisBangunan(val);
      containerPills.appendChild(newBtn);
    }

    pilihJenisBangunan(val);

    const container = document.getElementById('container-jenis-kustom');
    if (container) container.classList.add('hidden');
  }

  // Traking otomatis opsional saat halaman terbuka jika izin sudah pernah diberikan sebelumnya
  if (navigator.permissions && navigator.permissions.query) {
    navigator.permissions.query({ name: 'geolocation' }).then((perm) => {
      if (perm.state === 'granted') {
        const inp = document.getElementById('lokasi');
        if (inp && !inp.value.trim()) {
          lacakLokasiGPS('lokasi');
        }
      }
    }).catch(() => {});
  }
</script>

<div class="max-w-2xl mx-auto space-y-5">

  <!-- Profil CV -->
  <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-3">
    <h2 class="text-sm font-bold text-slate-900 border-b border-slate-100 pb-2">Perusahaan</h2>
    
    <form action="/profil/cv" method="POST" enctype="multipart/form-data" class="space-y-3 text-xs">
      <div>
        <label for="nama" class="block font-semibold text-slate-700 mb-1">Perusahaan *</label>
        <input 
          type="text" 
          id="nama" 
          name="nama" 
          placeholder="Nama"
          value="<%= cv ? cv.nama : '' %>" 
          required 
          class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
        >
      </div>

      <div>
        <label class="block font-semibold text-slate-700 mb-1">Logo</label>
        <% if (cv && cv.logo_path) { %>
          <div class="mb-2 flex items-center space-x-2 p-2 bg-slate-50 border border-slate-200 rounded-lg">
            <img src="<%= cv.logo_path %>" alt="Logo" class="h-8 w-8 object-contain rounded">
            <span class="text-[11px] text-slate-500">Logo aktif</span>
          </div>
        <% } %>
        <input 
          type="file" 
          name="logo" 
          accept="image/*"
          class="w-full text-xs text-slate-500 file:mr-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-slate-100 file:text-slate-800 hover:file:bg-slate-200 cursor-pointer"
        >
      </div>

      <div>
        <button 
          type="submit" 
          class="px-3.5 py-1.5 bg-slate-900 hover:bg-slate-800 text-white font-semibold rounded-lg shadow-sm transition-all"
        >
          Simpan
        </button>
      </div>
    </form>
  </div>

  <!-- Kode Akses Masuk (PIN) -->
  <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-3">
    <h2 class="text-sm font-bold text-slate-900 border-b border-slate-100 pb-2">Kode Akses (PIN)</h2>

    <form action="/profil/kode-akses" method="POST" class="space-y-3 text-xs">
      <div>
        <label for="kode_baru" class="block font-semibold text-slate-700 mb-1">PIN *</label>
        <input 
          type="text" 
          id="kode_baru" 
          name="kode_baru" 
          placeholder="231125"
          value="<%= user && user.kode_akses ? user.kode_akses : '231125' %>" 
          required 
          minlength="4"
          maxlength="20"
          class="w-full sm:w-64 px-3 py-2 border border-slate-300 rounded-lg text-xs font-mono font-bold tracking-widest focus:outline-none focus:ring-1 focus:ring-slate-900"
        >
      </div>

      <div>
        <button 
          type="submit" 
          class="px-3.5 py-1.5 bg-slate-900 hover:bg-slate-800 text-white font-semibold rounded-lg shadow-sm transition-all"
        >
          Simpan
        </button>
      </div>
    </form>
  </div>

  <!-- Sandi -->
  <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-3">
    <h2 class="text-sm font-bold text-slate-900 border-b border-slate-100 pb-2">Kata Sandi</h2>
    
    <form action="/profil/password" method="POST" class="space-y-3 text-xs">
      <div>
        <label for="sandi_lama" class="block font-semibold text-slate-700 mb-1">Sandi Lama *</label>
        <input 
          type="password" 
          id="sandi_lama" 
          name="sandi_lama" 
          placeholder="Sandi lama"
          required 
          class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
        >
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label for="sandi_baru" class="block font-semibold text-slate-700 mb-1">Sandi Baru *</label>
          <input 
            type="password" 
            id="sandi_baru" 
            name="sandi_baru" 
            placeholder="Min. 10 karakter"
            required 
            minlength="10" 
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
          >
        </div>

        <div>
          <label for="konfirmasi_sandi" class="block font-semibold text-slate-700 mb-1">Konfirmasi *</label>
          <input 
            type="password" 
            id="konfirmasi_sandi" 
            name="konfirmasi_sandi" 
            placeholder="Ulangi sandi"
            required 
            minlength="10" 
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
          >
        </div>
      </div>

      <div>
        <button 
          type="submit" 
          class="px-3.5 py-1.5 bg-slate-900 hover:bg-slate-800 text-white font-semibold rounded-lg shadow-sm transition-all"
        >
          Simpan
        </button>
      </div>
    </form>
  </div>

  <!-- Backup SQLite -->
  <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-3 text-xs">
    <h2 class="text-sm font-bold text-slate-900 border-b border-slate-100 pb-2">Cadangan Database</h2>

    <div>
      <a 
        href="/cadangan/unduh" 
        class="inline-flex items-center space-x-1.5 px-3.5 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold rounded-lg shadow-sm transition-all"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
        <span>Unduh Database</span>
      </a>
    </div>
  </div>

</div>

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MyProyek</title>
  <link rel="icon" type="image/png" href="/image/icon.png">
  <link rel="apple-touch-icon" href="/image/icon.png">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', '-apple-system', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace']
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #f8fafc;
      color: #0f172a;
      -webkit-font-smoothing: antialiased;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased">

  <!-- Header -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-14">
        
        <!-- Logo -->
        <div class="flex items-center space-x-5">
          <a href="/" class="flex items-center space-x-2.5">
            <% if (cv && cv.logo_path) { %>
              <img src="<%= cv.logo_path %>" alt="MyProyek" class="h-8 w-8 object-contain rounded-lg border border-slate-200">
            <% } else { %>
              <img src="/image/icon.png" alt="MyProyek" class="h-8 w-8 object-contain rounded-lg shadow-xs">
            <% } %>
            <div class="flex flex-col">
              <span class="font-extrabold tracking-tight text-slate-900 text-base leading-none">MyProyek</span>
              <span class="text-[9px] font-semibold text-slate-400 tracking-wider uppercase mt-0.5">Keuangan Proyek</span>
            </div>
          </a>

          <!-- Navigasi Desktop -->
          <nav class="hidden md:flex items-center space-x-1 pl-4 border-l border-slate-200 text-xs">
            <a href="/" class="px-3 py-1.5 rounded-lg font-semibold transition-colors <%= currentPath === '/' ? 'text-slate-900 bg-slate-100' : 'text-slate-600 hover:text-slate-900' %>">
              Proyek
            </a>
            <a href="/laporan" class="px-3 py-1.5 rounded-lg font-semibold transition-colors <%= currentPath === '/laporan' ? 'text-slate-900 bg-slate-100' : 'text-slate-600 hover:text-slate-900' %>">
              Laporan
            </a>
            <a href="/histori" class="px-3 py-1.5 rounded-lg font-semibold transition-colors <%= (currentPath === '/histori' || currentPath === '/riwayat-tahunan') ? 'text-slate-900 bg-slate-100' : 'text-slate-600 hover:text-slate-900' %>">
              Histori
            </a>
            <a href="/cabang" class="px-3 py-1.5 rounded-lg font-semibold transition-colors <%= currentPath === '/cabang' ? 'text-slate-900 bg-slate-100' : 'text-slate-600 hover:text-slate-900' %>">
              Cabang
            </a>
          </nav>
        </div>

        <!-- Aksi Cepat & Profil -->
        <div class="flex items-center space-x-2">
          <a href="/proyek/baru" class="inline-flex items-center space-x-1 px-2.5 sm:px-3 py-1.5 text-xs font-semibold rounded-lg text-white bg-slate-900 hover:bg-slate-800 transition-all shadow-sm" title="Daftarkan Proyek">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
            <span class="hidden sm:inline">Proyek</span>
          </a>

          <div class="flex items-center pl-1.5 sm:pl-2 space-x-1 border-l border-slate-200">
            <a href="/profil" class="hidden sm:flex text-xs font-semibold text-slate-700 hover:text-slate-900 px-2 py-1.5 rounded-lg hover:bg-slate-100 transition-colors items-center space-x-1" title="Pengaturan Profil">
              <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
              <span>Profil</span>
            </a>
            <a href="/logout" class="text-xs text-slate-400 hover:text-rose-600 p-1.5 rounded-lg transition-colors" title="Keluar">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- Navigasi HP (Segmented 5-Grid Simetris & Rapi) -->
    <div class="md:hidden grid grid-cols-5 gap-1 p-1.5 border-t border-slate-200/80 bg-slate-50 text-[11px] font-semibold text-center">
      <a href="/" class="py-1.5 rounded-lg transition-all <%= currentPath === '/' ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900' %>">
        Proyek
      </a>
      <a href="/laporan" class="py-1.5 rounded-lg transition-all <%= currentPath === '/laporan' ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900' %>">
        Laporan
      </a>
      <a href="/histori" class="py-1.5 rounded-lg transition-all <%= (currentPath === '/histori' || currentPath === '/riwayat-tahunan') ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900' %>">
        Histori
      </a>
      <a href="/cabang" class="py-1.5 rounded-lg transition-all <%= currentPath === '/cabang' ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900' %>">
        Cabang
      </a>
      <a href="/profil" class="py-1.5 rounded-lg transition-all <%= currentPath === '/profil' ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900' %>">
        Profil
      </a>
    </div>
  </header>

  <!-- Notifikasi Flash -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 mt-4">
      <div id="flash-alert-success" class="p-3 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-xs flex items-center justify-between shadow-sm">
        <div class="flex items-center space-x-2">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
          <span class="font-medium"><%= success %></span>
        </div>
        <button onclick="document.getElementById('flash-alert-success').remove()" class="text-emerald-500 hover:text-emerald-800 text-base leading-none p-1">&times;</button>
      </div>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 mt-4">
      <div id="flash-alert-error" class="p-3 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-xs flex items-center justify-between shadow-sm">
        <div class="flex items-center space-x-2">
          <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          <span class="font-medium"><%= error %></span>
        </div>
        <button onclick="document.getElementById('flash-alert-error').remove()" class="text-rose-500 hover:text-rose-800 text-base leading-none p-1">&times;</button>
      </div>
    </div>
  <% } %>

  <!-- Konten Utama -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-5">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="bg-white border-t border-slate-200 py-3 text-[11px] text-slate-400 text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between">
      <span>MyProyek</span>
      <span>WIB</span>
    </div>
  </footer>

  <script src="/js/app.js"></script>
</body>
</html>

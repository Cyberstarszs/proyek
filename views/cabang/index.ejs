<div class="space-y-5 max-w-5xl mx-auto">

  <!-- Tombol Aksi Tambah Cabang -->
  <div class="flex items-center justify-end pb-2 sm:pb-3 border-b border-slate-200">
    <button 
      onclick="openModal('modal-tambah-cabang')" 
      class="inline-flex items-center space-x-1 px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg shadow-sm transition-all"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
      <span>Tambah</span>
    </button>
  </div>

  <!-- Tabel Cabang -->
  <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-100 text-left text-xs">
        <thead class="bg-slate-50 text-slate-600 font-semibold uppercase tracking-wider text-[11px]">
          <tr>
            <th class="py-3 px-4">Nama</th>
            <th class="py-3 px-4">Kota</th>
            <th class="py-3 px-4">Proyek</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-slate-700">
          <% if (cabangList.length === 0) { %>
            <tr>
              <td colspan="5" class="py-8 text-center text-slate-400">
                Belum ada cabang.
              </td>
            </tr>
          <% } else { %>
            <% cabangList.forEach(c => { %>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="py-3 px-4 font-bold text-slate-900">
                  <%= c.nama %>
                </td>
                <td class="py-3 px-4 text-slate-600">
                  <%= c.kota || '-' %>
                </td>
                <td class="py-3 px-4">
                  <span class="text-slate-600 font-medium">
                    <%= c.total_proyek %> (<%= c.proyek_aktif %> aktif)
                  </span>
                </td>
                <td class="py-3 px-4">
                  <% if (c.is_active === 1) { %>
                    <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                      Aktif
                    </span>
                  <% } else { %>
                    <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-slate-100 text-slate-500 border border-slate-200">
                      Nonaktif
                    </span>
                  <% } %>
                </td>
                <td class="py-3 px-4 text-right">
                  <form action="/cabang/<%= c.id %>/toggle" method="POST" class="inline">
                    <button 
                      type="submit" 
                      class="text-xs font-semibold px-2.5 py-1 rounded-lg border transition-all <%= c.is_active === 1 ? 'border-rose-200 text-rose-700 hover:bg-rose-50' : 'border-emerald-200 text-emerald-700 hover:bg-emerald-50' %>"
                    >
                      <%= c.is_active === 1 ? 'Nonaktifkan' : 'Aktifkan' %>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Modal Tambah Cabang -->
<div id="modal-tambah-cabang" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-xl max-w-sm w-full p-5 border border-slate-200 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between pb-2.5 border-b border-slate-100 mb-3">
      <h3 class="text-sm font-bold text-slate-900">Cabang Baru</h3>
      <button onclick="closeModal('modal-tambah-cabang')" class="text-slate-400 hover:text-slate-700 text-lg">&times;</button>
    </div>

    <form action="/cabang" method="POST" class="space-y-3 text-xs">
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Cabang *</label>
        <input 
          type="text" 
          name="nama" 
          placeholder="Cabang" 
          required 
          class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
        >
      </div>

      <div>
        <label class="block font-semibold text-slate-700 mb-1">Kota</label>
        <input 
          type="text" 
          name="kota" 
          placeholder="Kota" 
          class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
        >
      </div>

      <div class="flex justify-end space-x-2 pt-3 border-t border-slate-100">
        <button 
          type="button" 
          onclick="closeModal('modal-tambah-cabang')" 
          class="px-3 py-1.5 font-semibold text-slate-500 rounded-lg hover:bg-slate-100"
        >
          Batal
        </button>
        <button 
          type="submit" 
          class="px-4 py-1.5 font-semibold text-white bg-slate-900 rounded-lg hover:bg-slate-800 shadow-sm"
        >
          Simpan
        </button>
      </div>
    </form>
  </div>
</div>

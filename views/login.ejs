<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Masuk - MyProyek</title>
  <link rel="icon" type="image/png" href="/image/icon.png">
  <link rel="apple-touch-icon" href="/image/icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4 antialiased text-slate-800">
  <div class="max-w-sm w-full bg-white rounded-3xl shadow-sm border border-slate-200 p-7 sm:p-8">
    
    <!-- Logo MyProyek -->
    <div class="text-center mb-6">
      <img src="/image/icon.png" alt="MyProyek" class="inline-block h-14 w-14 object-contain rounded-2xl mb-3 shadow-sm ring-4 ring-slate-100">
      <h1 class="text-xl font-extrabold text-slate-900 tracking-tight">MyProyek</h1>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="mb-4 p-2.5 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-xs flex items-center space-x-1.5">
        <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
        <span><%= success %></span>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-4 p-2.5 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-xs flex items-center space-x-1.5">
        <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- Form Utama: Login Kode Akses / PIN (Auto-submit saat 6 digit terisi) -->
    <form id="form-kode" action="/login" method="POST" class="space-y-4 text-xs">
      <div>
        <label for="kode" class="block font-semibold text-slate-700 mb-1.5 text-center text-xs">
          PIN
        </label>
        <div class="relative">
          <input 
            type="password" 
            id="kode" 
            name="kode" 
            placeholder="231125"
            autofocus
            required
            inputmode="numeric"
            pattern="[0-9]*"
            autocomplete="current-password"
            maxlength="20"
            class="w-full text-center text-xl font-mono font-bold tracking-widest px-4 py-3 border border-slate-300 rounded-2xl focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-slate-900 bg-slate-50 focus:bg-white transition-all shadow-inner"
          >
        </div>
      </div>

      <div>
        <button 
          type="submit" 
          id="btn-submit-pin"
          class="w-full py-3 px-4 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-2xl text-xs shadow-sm transition-all hover:scale-[1.01] active:scale-[0.99]"
        >
          Masuk
        </button>
      </div>
    </form>

    <!-- Opsi Masuk Email & Sandi (Dropdown/Collapsible) -->
    <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
      <button 
        type="button" 
        onclick="toggleEmailForm()" 
        class="text-[11px] text-slate-400 hover:text-slate-600 focus:outline-none transition-colors"
      >
        Email
      </button>
      <a href="/lupa-sandi" class="text-[11px] text-slate-400 hover:text-slate-600 focus:outline-none transition-colors">
        Lupa Sandi
      </a>
    </div>

    <form id="form-email" action="/login" method="POST" class="hidden mt-3.5 space-y-3 text-xs text-left">
        <div>
          <label for="email" class="block font-semibold text-slate-700 mb-1">Email</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            value="<%= typeof email !== 'undefined' ? email : '' %>"
            placeholder="Email" 
            class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
          >
        </div>
        <div>
          <label for="password" class="block font-semibold text-slate-700 mb-1">Sandi</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            placeholder="Sandi" 
            class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
          >
        </div>
        <button type="submit" class="w-full py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold rounded-xl text-xs transition-colors">
          Masuk
        </button>
      </form>
    </div>

  </div>

  <script>
    // Auto-submit saat PIN 6 digit selesai diketik
    const pinInput = document.getElementById('kode');
    const pinForm = document.getElementById('form-kode');
    const submitBtn = document.getElementById('btn-submit-pin');

    if (pinInput && pinForm) {
      pinInput.addEventListener('input', () => {
        // Otomatis kirim saat mencapai 6 digit angka
        if (pinInput.value.length === 6) {
          submitBtn.disabled = true;
          submitBtn.innerText = 'Memverifikasi...';
          submitBtn.classList.add('opacity-75');
          setTimeout(() => {
            pinForm.submit();
          }, 120);
        }
      });
    }

    function toggleEmailForm() {
      const emailForm = document.getElementById('form-email');
      emailForm.classList.toggle('hidden');
    }
  </script>
</body>
</html>

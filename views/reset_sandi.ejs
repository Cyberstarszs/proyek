<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Sandi - MyProyek</title>
  <link rel="icon" type="image/png" href="/image/icon.png">
  <link rel="apple-touch-icon" href="/image/icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4 antialiased text-slate-800">
  <div class="max-w-sm w-full bg-white rounded-xl shadow-sm border border-slate-200 p-6 sm:p-7">
    
    <div class="text-center mb-5">
      <img src="/image/icon.png" alt="MyProyek" class="inline-block h-12 w-12 object-contain rounded-xl mb-2 shadow-sm">
      <h1 class="text-xl font-extrabold text-slate-900 tracking-tight">Sandi Baru</h1>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-4 p-2.5 bg-rose-50 border border-rose-200 text-rose-800 rounded-lg text-xs flex items-center space-x-1.5">
        <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/reset-sandi" method="POST" class="space-y-3 text-xs">
      <input type="hidden" name="token" value="<%= token %>">

      <div>
        <label for="sandi_baru" class="block font-semibold text-slate-700 mb-1">Sandi Baru *</label>
        <input 
          type="password" 
          id="sandi_baru" 
          name="sandi_baru" 
          placeholder="Min. 10 karakter"
          required 
          minlength="10"
          class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
        >
      </div>

      <div>
        <label for="konfirmasi_sandi" class="block font-semibold text-slate-700 mb-1">Konfirmasi *</label>
        <input 
          type="password" 
          id="konfirmasi_sandi" 
          name="konfirmasi_sandi" 
          placeholder="Ulangi sandi"
          required 
          minlength="10"
          class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-slate-900"
        >
      </div>

      <div class="pt-1">
        <button 
          type="submit" 
          class="w-full py-2 px-3 bg-slate-900 hover:bg-slate-800 text-white font-semibold rounded-lg text-xs shadow-sm transition-all"
        >
          Simpan
        </button>
      </div>
    </form>

    <div class="mt-4 pt-3 border-t border-slate-100 text-center text-xs">
      <a href="/login" class="text-slate-500 hover:text-slate-800 font-medium">
        Batal
      </a>
    </div>

  </div>
</body>
</html>
